# =============================================================================
# .env patch for V30 (internal token security) + V33 (resilience)
# =============================================================================
# How to apply on the server (one-time, idempotent — re-runs are no-ops):
#
#   cd /opt/SSO
#   grep -q '^SSO_INTERNAL_TOKEN=' .env || cat .env.v30-v33.patch >> .env
#   grep -q '^GATEWAY_INTERNAL_TOKEN=' .env || true
#   # ^ if your .env already has these (different value), DON'T overwrite
#   # the placeholder below; instead, replace the value in your .env with
#   # the same value across SSO_INTERNAL_TOKEN / GATEWAY_INTERNAL_TOKEN /
#   # QUERY_CATALOG_INTERNAL_TOKEN.
#
# Production: rotate the three *_INTERNAL_TOKEN vars to real values:
#   openssl rand -hex 32
# Set the SAME value on all three (single shared secret across
# sso-admin, api-gateway, query-service).
# =============================================================================

# ---- V30 — internal token security (MUST be set identically on all 3) ----
# Shared secret gating /internal/** on sso-admin (X-Internal-Token
# header). Default placeholder fails closed at boot (logged WARN,
# path-registry stays empty until configured).
SSO_INTERNAL_TOKEN=change-me-internal-shared-secret-32-bytes-min
GATEWAY_INTERNAL_TOKEN=change-me-internal-shared-secret-32-bytes-min
QUERY_CATALOG_INTERNAL_TOKEN=change-me-internal-shared-secret-32-bytes-min

# ---- V33 — query-service resilience defaults ----
# Bulkhead caps CONCURRENT JDBC calls per dialect. When the
# cap+queue is full the request returns 503 BULKHEAD_FULL
# with Retry-After: 1. Tune down for hot dialects, up for
# cold ones. The defaults are conservative for prod.
QUERY_BULKHEAD_MAX_CONCURRENT=20
QUERY_BULKHEAD_MAX_QUEUE=50
QUERY_BULKHEAD_WAIT_DURATION=200ms

# Rate limiter caps RPS per JWT principal (or per the shared
# "anonymous" bucket for /public/service traffic). Overflow
# returns 429 RATE_LIMITED with Retry-After: 1.
QUERY_RATE_LIMIT_RPS=100
QUERY_RATE_LIMIT_WINDOW=1s

# sso-admin calls this URL when a catalog mutation lands so
# query-service can refresh its path-registry immediately
# instead of waiting for the next 60s tick. In compose the
# docker-DNS name resolves; in host-mode dev override with
# http://localhost:8084.
QUERY_SERVICE_BASE_URL=http://query-service:8080
