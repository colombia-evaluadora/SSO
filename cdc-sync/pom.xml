<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example.cdc</groupId>
  <artifactId>cdc-sync-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <properties>
    <!-- Spring Boot 4.1.x (Java 25): bytecode 69 lo lee el ASM de Boot 4 y el
         Byte Buddy/Mockito gestionados ya conocen Java 25. -->
    <java.version>25</java.version>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <byte-buddy.version>1.17.8</byte-buddy.version>
    <debezium.version>3.1.0.Final</debezium.version>
    <!-- Kafka con la que se construyó Debezium 3.1 (version.kafka de su
         parent). Boot 4.1 gestiona Kafka 4.x, donde bootstrap.servers ya
         no tiene default y el motor embebido no arranca
         ("Missing required configuration bootstrap.servers"). -->
    <kafka.version>3.9.0</kafka.version>
    <ojdbc.version>23.3.0.23.09</ojdbc.version>
    <clickhouse.jdbc.version>0.7.2</clickhouse.jdbc.version>
    <testcontainers.version>1.20.3</testcontainers.version>
  </properties>

  <modules>
    <module>cdc-common</module>
    <module>cdc-generator</module>
    <module>cdc-capture</module>
    <module>cdc-worker</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.debezium</groupId>
        <artifactId>debezium-embedded</artifactId>
        <version>${debezium.version}</version>
      </dependency>
      <dependency>
        <groupId>com.oracle.database.jdbc</groupId>
        <artifactId>ojdbc11</artifactId>
        <version>${ojdbc.version}</version>
      </dependency>
      <dependency>
        <groupId>com.clickhouse</groupId>
        <artifactId>clickhouse-jdbc</artifactId>
        <version>${clickhouse.jdbc.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
