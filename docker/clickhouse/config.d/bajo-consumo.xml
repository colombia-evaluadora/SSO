<?xml version="1.0"?>
<!--
  ClickHouse de un solo nodo para la auditoria CDC: recibe unas pocas
  inserciones por segundo y sirve las consultas/exportaciones de auditoria.
  Los valores por defecto estan pensados para un servidor dedicado (caches de
  5 y 8 GB, 16 hilos de merge, nueve tablas de log internas escribiendo sin
  parar). Medido en local antes del cambio: 923 MB de logs internos frente a
  5 MB de auditoria, y 785 hilos.

  Referencia: Altinity KB, "Configure ClickHouse for low memory environments".
-->
<clickhouse>
    <!-- Protocolos que nadie usa: menos superficie expuesta. -->
    <mysql_port remove="1"/>
    <postgresql_port remove="1"/>
    <interserver_http_port remove="1"/>

    <!-- Logs internos sin consumidor en el repo: escriben y mergean sin parar. -->
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <processors_profile_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <opentelemetry_span_log remove="1"/>

    <!-- Se conservan para diagnosticar, con retencion acotada. -->
    <query_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </part_log>

    <!-- Memoria: tope sobre el limite del contenedor (cgroup), no del host. -->
    <max_server_memory_usage_to_ram_ratio>0.75</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>268435456</mark_cache_size>
    <index_mark_cache_size>67108864</index_mark_cache_size>
    <uncompressed_cache_size>16777216</uncompressed_cache_size>
    <mlock_executable>false</mlock_executable>

    <!-- Hilos: el pool global guardaba cientos de hilos ociosos. -->
    <max_thread_pool_size>2000</max_thread_pool_size>
    <max_thread_pool_free_size>64</max_thread_pool_free_size>
    <max_connections>128</max_connections>
    <max_concurrent_queries>16</max_concurrent_queries>

    <!-- Merges y tareas de fondo dimensionados para pocas inserciones. -->
    <background_pool_size>4</background_pool_size>
    <background_merges_mutations_concurrency_ratio>2</background_merges_mutations_concurrency_ratio>
    <background_merges_mutations_scheduling_policy>round_robin</background_merges_mutations_scheduling_policy>
    <background_move_pool_size>1</background_move_pool_size>
    <background_fetches_pool_size>1</background_fetches_pool_size>
    <background_common_pool_size>2</background_common_pool_size>
    <background_schedule_pool_size>8</background_schedule_pool_size>
    <background_buffer_flush_schedule_pool_size>1</background_buffer_flush_schedule_pool_size>
    <background_message_broker_schedule_pool_size>1</background_message_broker_schedule_pool_size>
    <background_distributed_schedule_pool_size>1</background_distributed_schedule_pool_size>

    <merge_tree>
        <merge_max_block_size>1024</merge_max_block_size>
        <max_bytes_to_merge_at_max_space_in_pool>1073741824</max_bytes_to_merge_at_max_space_in_pool>
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>2</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
        <number_of_free_entries_in_pool_to_execute_mutation>2</number_of_free_entries_in_pool_to_execute_mutation>
        <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>2</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
    </merge_tree>
</clickhouse>
