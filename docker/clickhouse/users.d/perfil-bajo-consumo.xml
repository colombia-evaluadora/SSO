<?xml version="1.0"?>
<!--
  Perfil por defecto acotado. No se baja a los 2 hilos de la guia de Altinity:
  las exportaciones de auditoria (reporting-service, query-service) agregan
  sobre audit_log y necesitan algo de paralelismo. Lo que no cabe en memoria se
  vuelca a disco en vez de abortar la consulta.
-->
<clickhouse>
    <profiles>
        <default>
            <max_threads>4</max_threads>
            <queue_max_wait_ms>1000</queue_max_wait_ms>
            <max_execution_time>600</max_execution_time>
            <max_bytes_before_external_group_by>268435456</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>268435456</max_bytes_before_external_sort>
            <input_format_parallel_parsing>0</input_format_parallel_parsing>
            <output_format_parallel_formatting>0</output_format_parallel_formatting>
        </default>
    </profiles>
</clickhouse>
