<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/0/POM4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/0/POM4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.co.eurekatic</groupId>
        <artifactId>sso-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>provisioner</artifactId>
    <name>provisioner</name>
    <description>
        Sidecar that translates admin-ui "kind=QUERY"
        microservice rows into Docker Engine API calls. The
        sole container in the stack that mounts the Docker
        unix socket — sso-admin talks to it over HTTP only.
    </description>

    <properties>
        <start-class>com.co.eurekatic.provisioner.ProvisionerApplication</start-class>
    </properties>

    <dependencies>
        <!--
            common: brings in OpenApiFactory (static helpers
            for the bearer-jwt security scheme, info, etc.)
            and transitively swagger-models (compile scope).
            Needed by ProvisionerOpenApiConfig, which the
            api-gateway aggregator reads to merge the
            provisioner's spec into the platform doc.

            Previous commit (47beb91) added the @Configuration
            class but forgot this dep — the docker build
            failed on first deploy with
            "package com.co.eurekatic.common.openapi does not
            exist". This dependency unblocks the build.
        -->
        <dependency>
            <groupId>com.co.eurekatic</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Servlet-only REST surface. No DB, no security
             (the only caller is sso-admin over the internal
             docker network), no Eureka. We add actuator for
             the /actuator/health the sso-admin probe polls. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Observability: pure-OTLP export via the single Boot 4 starter. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-appender-1.0</artifactId>
            <version>${opentelemetry-instrumentation.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ObjectMapper + JsonNode for shaping the Docker
             Engine API calls and parsing their responses. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            springdoc-openapi: publishes this service's /v3/api-docs so
            api-gateway's OpenApiAggregatorService can merge it into the
            doc at /api/docs. See auth-center/pom.xml for the full
            rationale. *-api*, not *-ui*: the gateway owns Swagger UI.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>${springdoc-openapi.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>