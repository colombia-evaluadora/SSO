<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local copy of the shared logback config in `common`. The provisioner
  does not depend on `common`, so it cannot inherit the shared config
  from the classpath. Kept in lockstep with the version in
  common/src/main/resources/logback-spring.xml — if you change one,
  change the other.
-->
<configuration>

  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

  <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="OTEL"/>
  </root>

</configuration>
