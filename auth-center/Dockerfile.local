# syntax=docker/dockerfile:1.7
#
# Local-only Dockerfile for auth-center: packages an already-built
# jar into a slim runtime image. Used when the maven build inside
# Docker runs out of memory (colima default is too low). The jar
# is built on the host (see /tmp/build-authcenter.sh).

FROM eclipse-temurin:21-jre-jammy
WORKDIR /app

RUN groupadd --system --gid 1000 app && \
    useradd  --system --uid 1000 --gid app --home /app app

COPY auth-center/target/auth-center.jar /app/app.jar

USER app
EXPOSE 8081

ENTRYPOINT ["java", \
    "-XX:+UseContainerSupport", \
    "-XX:MaxRAMPercentage=70", \
    "-XX:+ExitOnOutOfMemoryError", \
    "-Djava.security.egd=file:/dev/./urandom", \
    "-jar", "/app/app.jar"]
