			</element>
			<element kind="textField" x="508" y="53" width="60" height="16" fontName="DejaVu Sans" fontSize="9" forecolor="#16305C" hTextAlign="Left" vTextAlign="Top" blankWhenNull="true" textAdjust="ScaleFont">
