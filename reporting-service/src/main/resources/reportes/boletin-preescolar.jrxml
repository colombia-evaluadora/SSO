<?xml version="1.0" encoding="UTF-8"?>
<!--
  Boletin de preescolar: UN BOLETIN POR ESTUDIANTE, de una o mas hojas.

  El boletin es un grupo por estudiante (hoja nueva y numeracion propia) con
  bandas de detalle que fluyen: datos, titulo, observacion, evidencias y
  firma. La observacion se parte entre hojas; las demas bandas no se parten y
  pasan enteras a la siguiente si no caben. Fondo y cabecera se repiten en
  cada hoja, y el pie dice "Pagina N de M" del boletin.

  DOS COSAS QUE PARECEN ERRORES Y NO LO SON, medidas contra JasperReports
  7.0.8 antes de escribir esta plantilla:

    1. NO lleva xmlns ni schemaLocation. Con el namespace que trae cualquier
       ejemplo de la version 6, Jasper 7 responde "Unable to load report" sin
       decir por que.
    2. Los elementos de la banda son <element kind="..."> y no <staticText>,
       <textField> o <image>. JR7 unifico la sintaxis; la vieja falla con
       "Unrecognized field" contra JRDesignBand.

  Pagina Oficio (613x894, el tamaño de los fondos institucionales) y margenes
  en cero, porque el fondo se imprime a sangre.

  (Ojo con los comentarios: XML prohibe dos guiones seguidos dentro de uno, y
  Jasper responde a eso con el mismo "Unable to load report" de siempre.)

  La fuente se nombra en CADA elemento a proposito. El estilo por defecto con
  DejaVu Sans solo existe en el diseño programatico de PdfRenderer, y sin el
  reaparece el separado de letras en los acentos.

  Generada por scripts/generar-boletin-preescolar.py: editar el script, no
  este archivo.
-->
<jasperReport name="boletin-preescolar"
              pageWidth="613" pageHeight="894" columnWidth="613"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0"
              whenNoDataType="NoPages">

	<parameter name="TITULO" class="java.lang.String"/>
	<parameter name="GENERADO" class="java.lang.String"/>
	<parameter name="TOTAL" class="java.lang.Integer"/>
	<parameter name="USUARIO" class="java.lang.String"/>
	<parameter name="FILTROS" class="java.lang.String"/>

	<field name="ee_nombre" class="java.lang.String"/>
	<field name="ee_dane" class="java.lang.String"/>
	<field name="ee_nit" class="java.lang.String"/>
	<field name="ciudad" class="java.lang.String"/>
	<field name="sede_nombre" class="java.lang.String"/>
	<field name="nivel_ensenanza" class="java.lang.String"/>
	<field name="grado_nombre" class="java.lang.String"/>
	<field name="grupo_etiqueta" class="java.lang.String"/>
	<field name="periodo_nombre" class="java.lang.String"/>
	<field name="anio" class="java.lang.String"/>
	<field name="estudiante" class="java.lang.String"/>
	<field name="documento" class="java.lang.String"/>
	<field name="asignatura_nombre" class="java.lang.String"/>
	<field name="observacion" class="java.lang.String"/>
	<field name="observacion_estado" class="java.lang.String"/>
	<field name="rector_nombre" class="java.lang.String"/>
	<field name="rector_documento" class="java.lang.String"/>
	<field name="departamento" class="java.lang.String"/>
	<field name="jornada" class="java.lang.String"/>
	<field name="tipo_documento" class="java.lang.String"/>
	<field name="evidencia1_titulo" class="java.lang.String"/>
	<field name="evidencia2_titulo" class="java.lang.String"/>
	<field name="evidencia3_titulo" class="java.lang.String"/>
	<field name="evidencia4_titulo" class="java.lang.String"/>
	<field name="evidencia5_titulo" class="java.lang.String"/>
	<field name="evidencia6_titulo" class="java.lang.String"/>
	<field name="evidencia1_fecha" class="java.lang.String"/>
	<field name="evidencia2_fecha" class="java.lang.String"/>
	<field name="evidencia3_fecha" class="java.lang.String"/>
	<field name="evidencia4_fecha" class="java.lang.String"/>
	<field name="evidencia5_fecha" class="java.lang.String"/>
	<field name="evidencia6_fecha" class="java.lang.String"/>
	<field name="fondo_archivo" class="java.io.InputStream"/>
	<field name="escudo_archivo" class="java.io.InputStream"/>
	<field name="foto_archivo" class="java.io.InputStream"/>
	<field name="evidencia1_archivo" class="java.io.InputStream"/>
	<field name="evidencia2_archivo" class="java.io.InputStream"/>
	<field name="evidencia3_archivo" class="java.io.InputStream"/>
	<field name="evidencia4_archivo" class="java.io.InputStream"/>
	<field name="evidencia5_archivo" class="java.io.InputStream"/>
	<field name="evidencia6_archivo" class="java.io.InputStream"/>
	<group name="boletin" startNewPage="true" resetPageNumber="true">
		<expression><![CDATA[$F{documento} + "|" + $F{estudiante}]]></expression>
	</group>

	<background height="894" splitType="Prevent">
			<element kind="image" x="0" y="0" width="613" height="894" scaleImage="FillFrame" hImageAlign="Center" vImageAlign="Middle" onErrorType="Blank" usingCache="true">
			<expression><![CDATA[$F{fondo_archivo}]]></expression>
		</element>
	</background>
	<pageHeader height="126" splitType="Prevent">
			<element kind="rectangle" x="40" y="8" width="88" height="88" backcolor="#FFFFFF" mode="Opaque" radius="44">
			<printWhenExpression><![CDATA[$F{escudo_archivo} != null]]></printWhenExpression>
			<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "acento")]]></propertyExpression>
			<pen lineWidth="1.5"/>
		</element>
		<element kind="image" x="50" y="18" width="68" height="68" scaleImage="RetainShape" hImageAlign="Center" vImageAlign="Middle" onErrorType="Blank" usingCache="true">
			<printWhenExpression><![CDATA[$F{escudo_archivo} != null]]></printWhenExpression>
			<expression><![CDATA[$F{escudo_archivo}]]></expression>
		</element>
		<element kind="textField" x="140" y="4" width="205" height="54" fontName="DejaVu Sans" fontSize="18" forecolor="#16305C" hTextAlign="Left" vTextAlign="Middle" bold="true" blankWhenNull="true" textAdjust="ScaleFont">
			<printWhenExpression><![CDATA[$F{escudo_archivo} != null]]></printWhenExpression>
			<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "franja")]]></propertyExpression>
			<expression><![CDATA[$F{ee_nombre}]]></expression>
		</element>
		<element kind="textField" x="140" y="77" width="205" height="13" fontName="DejaVu Sans" fontSize="8.5" forecolor="#16305C" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true">
			<printWhenExpression><![CDATA[$F{escudo_archivo} != null]]></printWhenExpression>
			<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "banda")]]></propertyExpression>
			<expression><![CDATA["DANE: " + $F{ee_dane} + ("".equals($F{ee_nit}) ? "" : "   \u00b7   NIT: " + $F{ee_nit})]]></expression>
		</element>
		<element kind="textField" x="140" y="90" width="205" height="13" fontName="DejaVu Sans" fontSize="8.5" forecolor="#16305C" hTextAlign="Left" vTextAlign="Middle" bold="true" blankWhenNull="true">
			<printWhenExpression><![CDATA[$F{escudo_archivo} != null]]></printWhenExpression>
			<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "banda")]]></propertyExpression>
			<expression><![CDATA[($F{ciudad} + ("".equals($F{departamento}) ? "" : " - " + $F{departamento})).toUpperCase()]]></expression>
		</element>
		<element kind="textField" x="40" y="4" width="305" height="54" fontName="DejaVu Sans" fontSize="18" forecolor="#16305C" hTextAlign="Left" vTextAlign="Middle" bold="true" blankWhenNull="true" textAdjust="ScaleFont">
			<printWhenExpression><![CDATA[$F{escudo_archivo} == null]]></printWhenExpression>
			<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "franja")]]></propertyExpression>
			<expression><![CDATA[$F{ee_nombre}]]></expression>
		</element>
		<element kind="textField" x="40" y="77" width="305" height="13" fontName="DejaVu Sans" fontSize="8.5" forecolor="#16305C" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true">
			<printWhenExpression><![CDATA[$F{escudo_archivo} == null]]></printWhenExpression>
			<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "banda")]]></propertyExpression>
			<expression><![CDATA["DANE: " + $F{ee_dane} + ("".equals($F{ee_nit}) ? "" : "   \u00b7   NIT: " + $F{ee_nit})]]></expression>
		</element>
		<element kind="textField" x="40" y="90" width="305" height="13" fontName="DejaVu Sans" fontSize="8.5" forecolor="#16305C" hTextAlign="Left" vTextAlign="Middle" bold="true" blankWhenNull="true">
			<printWhenExpression><![CDATA[$F{escudo_archivo} == null]]></printWhenExpression>
			<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "banda")]]></propertyExpression>
			<expression><![CDATA[($F{ciudad} + ("".equals($F{departamento}) ? "" : " - " + $F{departamento})).toUpperCase()]]></expression>
		</element>
		<element kind="textField" x="393" y="24" width="180" height="14" fontName="DejaVu Sans" fontSize="8" forecolor="#16305C" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true">
			<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "gris")]]></propertyExpression>
			<expression><![CDATA["Expedido: " + $P{GENERADO}]]></expression>
		</element>
		<element kind="textField" x="40" y="112" width="360" height="12" fontName="DejaVu Sans" fontSize="7" forecolor="#16305C" hTextAlign="Left" vTextAlign="Top" bold="true" blankWhenNull="true">
			<printWhenExpression><![CDATA[$V{PAGE_NUMBER} > 1]]></printWhenExpression>
			<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "gris")]]></propertyExpression>
			<expression><![CDATA[$F{estudiante} + " (continuacion)"]]></expression>
		</element>
	</pageHeader>
	<detail>
		<band height="104" splitType="Prevent">
			<element kind="rectangle" x="40" y="2" width="80" height="96" backcolor="#E8EEF7" mode="Opaque" radius="6">
				<propertyExpression name="net.sf.jasperreports.style.backcolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "panel")]]></propertyExpression>
				<pen lineWidth="0.0"/>
			</element>
			<element kind="image" x="43" y="5" width="74" height="90" scaleImage="RetainShape" hImageAlign="Center" vImageAlign="Middle" onErrorType="Blank">
				<expression><![CDATA[$F{foto_archivo}]]></expression>
			</element>
			<element kind="textField" x="132" y="0" width="441" height="22" fontName="DejaVu Sans" fontSize="15" forecolor="#16305C" hTextAlign="Left" vTextAlign="Middle" bold="true" blankWhenNull="true" textAdjust="ScaleFont">
				<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "titulo")]]></propertyExpression>
				<expression><![CDATA[$F{estudiante}]]></expression>
			</element>
			<element kind="textField" x="132" y="22" width="441" height="13" fontName="DejaVu Sans" fontSize="9" forecolor="#16305C" hTextAlign="Left" vTextAlign="Top" bold="true" blankWhenNull="true">
				<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "acento")]]></propertyExpression>
				<expression><![CDATA[("".equals($F{tipo_documento}) ? "Documento" : $F{tipo_documento}) + ": " + $F{documento}]]></expression>
			</element>
			<element kind="rectangle" x="132" y="38" width="441" height="34" backcolor="#E8EEF7" mode="Opaque" radius="6">
				<propertyExpression name="net.sf.jasperreports.style.backcolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "panel")]]></propertyExpression>
				<pen lineWidth="0.0"/>
			</element>
			<element kind="staticText" x="138" y="45" width="20" height="20" fontName="Material Icons" fontSize="18" forecolor="#16305C" hTextAlign="Center" vTextAlign="Middle">
				<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "acento")]]></propertyExpression>
				<text><![CDATA[]]></text>
			</element>
			<element kind="staticText" x="162" y="41" width="130" height="12" fontName="DejaVu Sans" fontSize="8" forecolor="#16305C" hTextAlign="Left" vTextAlign="Middle" bold="true">
				<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "acento")]]></propertyExpression>
				<text><![CDATA[Sede:]]></text>
			</element>
			<element kind="textField" x="162" y="53" width="130" height="16" fontName="DejaVu Sans" fontSize="9" forecolor="#16305C" hTextAlign="Left" vTextAlign="Top" blankWhenNull="true" textAdjust="ScaleFont">
				<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "texto")]]></propertyExpression>
				<expression><![CDATA[$F{sede_nombre}]]></expression>
			</element>
			<element kind="line" x="295" y="44" width="1" height="22" forecolor="#9FB3D1">
				<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "borde")]]></propertyExpression>
			</element>
			<element kind="staticText" x="300" y="45" width="20" height="20" fontName="Material Icons" fontSize="18" forecolor="#16305C" hTextAlign="Center" vTextAlign="Middle">
				<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "acento")]]></propertyExpression>
				<text><![CDATA[]]></text>
			</element>
			<element kind="staticText" x="324" y="41" width="60" height="12" fontName="DejaVu Sans" fontSize="8" forecolor="#16305C" hTextAlign="Left" vTextAlign="Middle" bold="true">
				<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "acento")]]></propertyExpression>
				<text><![CDATA[Nivel:]]></text>
			</element>
			<element kind="textField" x="324" y="53" width="60" height="16" fontName="DejaVu Sans" fontSize="9" forecolor="#16305C" hTextAlign="Left" vTextAlign="Top" blankWhenNull="true" textAdjust="ScaleFont">
				<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "texto")]]></propertyExpression>
