				<pen lineWidth="1.25"/>
			</element>
			<element kind="line" x="572" y="11" width="1" height="13" forecolor="#16305C" stretchType="ContainerHeight">
				<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "acento")]]></propertyExpression>
				<pen lineWidth="1.25"/>
			</element>
			<element kind="textField" x="54" y="0" width="304" height="22" fontName="DejaVu Sans" fontSize="10" forecolor="#FFFFFF" hTextAlign="Left" vTextAlign="Middle" bold="true" textAdjust="StretchHeight">
				<expression><![CDATA[$F{asignatura_nombre} == null || $F{asignatura_nombre}.trim().isEmpty() ? "SEGUIMIENTO Y VALORACION" : $F{asignatura_nombre}.toUpperCase()]]></expression>
				<box topPadding="5" bottomPadding="5"/>
			</element>
		</band>
		<band height="42" splitType="Stretch">
			<element kind="textField" x="40" y="0" width="533" height="30" fontName="DejaVu Sans" fontSize="10" forecolor="#16305C" hTextAlign="Justified" vTextAlign="Top" textAdjust="StretchHeight">
				<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "texto")]]></propertyExpression>
				<propertyExpression name="net.sf.jasperreports.style.box.pen.lineColor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "acento")]]></propertyExpression>
				<expression><![CDATA[$F{observacion} == null || $F{observacion}.trim().isEmpty() ? "Sin observaciones registradas para este periodo." : $F{observacion}]]></expression>
				<box topPadding="4" leftPadding="14" bottomPadding="12" rightPadding="14">
					<pen lineWidth="1.25" lineColor="#16305C"/>
