			</element>
			<element kind="textField" x="416" y="53" width="60" height="16" fontName="DejaVu Sans" fontSize="9" forecolor="#16305C" hTextAlign="Left" vTextAlign="Top" blankWhenNull="true" textAdjust="ScaleFont">
				<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "texto")]]></propertyExpression>
