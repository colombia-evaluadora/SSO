<?xml version="1.0" encoding="UTF-8"?>
<!--
  Boletin de preescolar: UN BOLETIN POR ESTUDIANTE, de una o mas hojas.

  El boletin es un grupo por estudiante (hoja nueva y numeracion propia) con
  bandas de detalle que fluyen: datos, titulo, observacion, evidencias y
  firma. La observacion se parte entre hojas; las demas bandas no se parten y
  pasan enteras a la siguiente si no caben. Fondo y cabecera se repiten en
  cada hoja, y el pie dice "Pagina N de M" del boletin.

  DOS COSAS QUE PARECEN ERRORES Y NO LO SON, medidas contra JasperReports
  7.0.8 antes de escribir esta plantilla:

    1. NO lleva xmlns ni schemaLocation. Con el namespace que trae cualquier
       ejemplo de la version 6, Jasper 7 responde "Unable to load report" sin
       decir por que.
    2. Los elementos de la banda son <element kind="..."> y no <staticText>,
       <textField> o <image>. JR7 unifico la sintaxis; la vieja falla con
       "Unrecognized field" contra JRDesignBand.

  Pagina Oficio (613x894, el tamaño de los fondos institucionales) y margenes
  en cero, porque el fondo se imprime a sangre.

  (Ojo con los comentarios: XML prohibe dos guiones seguidos dentro de uno, y
  Jasper responde a eso con el mismo "Unable to load report" de siempre.)

  La fuente se nombra en CADA elemento a proposito. El estilo por defecto con
  DejaVu Sans solo existe en el diseño programatico de PdfRenderer, y sin el
  reaparece el separado de letras en los acentos.

  Generada por scripts/generar-boletin-preescolar.py: editar el script, no
  este archivo.
-->
<jasperReport name="boletin-preescolar"
              pageWidth="613" pageHeight="894" columnWidth="613"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0"
              whenNoDataType="NoPages">

	<parameter name="TITULO" class="java.lang.String"/>
	<parameter name="GENERADO" class="java.lang.String"/>
	<parameter name="TOTAL" class="java.lang.Integer"/>
	<parameter name="USUARIO" class="java.lang.String"/>
	<parameter name="FILTROS" class="java.lang.String"/>

	<field name="ee_nombre" class="java.lang.String"/>
	<field name="ee_dane" class="java.lang.String"/>
	<field name="ee_nit" class="java.lang.String"/>
	<field name="ciudad" class="java.lang.String"/>
	<field name="sede_nombre" class="java.lang.String"/>
	<field name="nivel_ensenanza" class="java.lang.String"/>
	<field name="grado_nombre" class="java.lang.String"/>
	<field name="grupo_etiqueta" class="java.lang.String"/>
	<field name="periodo_nombre" class="java.lang.String"/>
	<field name="anio" class="java.lang.String"/>
	<field name="estudiante" class="java.lang.String"/>
	<field name="documento" class="java.lang.String"/>
	<field name="asignatura_nombre" class="java.lang.String"/>
	<field name="observacion" class="java.lang.String"/>
	<field name="observacion_estado" class="java.lang.String"/>
	<field name="rector_nombre" class="java.lang.String"/>
	<field name="rector_documento" class="java.lang.String"/>
	<field name="evidencia1_titulo" class="java.lang.String"/>
	<field name="evidencia2_titulo" class="java.lang.String"/>
	<field name="evidencia3_titulo" class="java.lang.String"/>
	<field name="evidencia4_titulo" class="java.lang.String"/>
	<field name="evidencia5_titulo" class="java.lang.String"/>
	<field name="evidencia6_titulo" class="java.lang.String"/>
	<field name="evidencia1_fecha" class="java.lang.String"/>
	<field name="evidencia2_fecha" class="java.lang.String"/>
	<field name="evidencia3_fecha" class="java.lang.String"/>
	<field name="evidencia4_fecha" class="java.lang.String"/>
	<field name="evidencia5_fecha" class="java.lang.String"/>
	<field name="evidencia6_fecha" class="java.lang.String"/>
	<field name="fondo_archivo" class="java.io.InputStream"/>
	<field name="foto_archivo" class="java.io.InputStream"/>
	<field name="evidencia1_archivo" class="java.io.InputStream"/>
	<field name="evidencia2_archivo" class="java.io.InputStream"/>
	<field name="evidencia3_archivo" class="java.io.InputStream"/>
	<field name="evidencia4_archivo" class="java.io.InputStream"/>
	<field name="evidencia5_archivo" class="java.io.InputStream"/>
	<field name="evidencia6_archivo" class="java.io.InputStream"/>
	<group name="boletin" startNewPage="true" resetPageNumber="true">
		<expression><![CDATA[$F{documento} + "|" + $F{estudiante}]]></expression>
	</group>

	<background height="894" splitType="Prevent">
			<element kind="image" x="0" y="0" width="613" height="894" scaleImage="FillFrame" hImageAlign="Center" vImageAlign="Middle" onErrorType="Blank" usingCache="true">
			<expression><![CDATA[$F{fondo_archivo}]]></expression>
		</element>
	</background>
	<pageHeader height="126" splitType="Prevent">
			<element kind="textField" x="40" y="6" width="260" height="29" fontName="DejaVu Sans" fontSize="13" forecolor="#16305C" hTextAlign="Left" vTextAlign="Middle" bold="true" blankWhenNull="true" textAdjust="ScaleFont">
			<printWhenExpression><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.claro($F{fondo_archivo}, 0.065, 0.009, 0.424, 0.056)]]></printWhenExpression>
			<expression><![CDATA[$F{ee_nombre}]]></expression>
		</element>
		<element kind="textField" x="40" y="6" width="260" height="29" fontName="DejaVu Sans" fontSize="13" forecolor="#FFFFFF" hTextAlign="Left" vTextAlign="Middle" bold="true" blankWhenNull="true" textAdjust="ScaleFont">
			<printWhenExpression><![CDATA[!com.co.eurekatic.reporting.render.TonoFondo.claro($F{fondo_archivo}, 0.065, 0.009, 0.424, 0.056)]]></printWhenExpression>
			<expression><![CDATA[$F{ee_nombre}]]></expression>
		</element>
		<element kind="textField" x="40" y="35" width="260" height="10" fontName="DejaVu Sans" fontSize="7" forecolor="#16305C" hTextAlign="Left" vTextAlign="Top" blankWhenNull="true">
			<printWhenExpression><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.claro($F{fondo_archivo}, 0.065, 0.009, 0.424, 0.056)]]></printWhenExpression>
			<expression><![CDATA["Dane: " + $F{ee_dane} + "   -   Nit: " + $F{ee_nit}]]></expression>
		</element>
		<element kind="textField" x="40" y="35" width="260" height="10" fontName="DejaVu Sans" fontSize="7" forecolor="#FFFFFF" hTextAlign="Left" vTextAlign="Top" blankWhenNull="true">
			<printWhenExpression><![CDATA[!com.co.eurekatic.reporting.render.TonoFondo.claro($F{fondo_archivo}, 0.065, 0.009, 0.424, 0.056)]]></printWhenExpression>
			<expression><![CDATA["Dane: " + $F{ee_dane} + "   -   Nit: " + $F{ee_nit}]]></expression>
		</element>
		<element kind="textField" x="40" y="45" width="260" height="10" fontName="DejaVu Sans" fontSize="7" forecolor="#16305C" hTextAlign="Left" vTextAlign="Top" blankWhenNull="true">
			<printWhenExpression><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.claro($F{fondo_archivo}, 0.065, 0.009, 0.424, 0.056)]]></printWhenExpression>
			<expression><![CDATA[$F{ciudad}]]></expression>
		</element>
		<element kind="textField" x="40" y="45" width="260" height="10" fontName="DejaVu Sans" fontSize="7" forecolor="#FFFFFF" hTextAlign="Left" vTextAlign="Top" blankWhenNull="true">
			<printWhenExpression><![CDATA[!com.co.eurekatic.reporting.render.TonoFondo.claro($F{fondo_archivo}, 0.065, 0.009, 0.424, 0.056)]]></printWhenExpression>
			<expression><![CDATA[$F{ciudad}]]></expression>
		</element>
		<element kind="textField" x="393" y="26" width="180" height="12" fontName="DejaVu Sans" fontSize="7" forecolor="#5A6B85" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true">
			<expression><![CDATA["Expedido: " + $P{GENERADO}]]></expression>
		</element>
		<element kind="textField" x="40" y="110" width="360" height="12" fontName="DejaVu Sans" fontSize="7" forecolor="#5A6B85" hTextAlign="Left" vTextAlign="Top" bold="true" blankWhenNull="true">
			<printWhenExpression><![CDATA[$V{PAGE_NUMBER} > 1]]></printWhenExpression>
			<expression><![CDATA[$F{estudiante} + " (continuacion)"]]></expression>
		</element>
	</pageHeader>
	<detail>
		<band height="104" splitType="Prevent">
			<element kind="rectangle" x="40" y="2" width="80" height="96" backcolor="#E8EEF7" mode="Opaque">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="image" x="41" y="3" width="78" height="94" scaleImage="RetainShape" hImageAlign="Center" vImageAlign="Middle" onErrorType="Blank">
				<expression><![CDATA[$F{foto_archivo}]]></expression>
			</element>
			<element kind="textField" x="132" y="2" width="441" height="20" fontName="DejaVu Sans" fontSize="13" forecolor="#16305C" hTextAlign="Left" vTextAlign="Top" bold="true" blankWhenNull="true">
				<expression><![CDATA[$F{estudiante}]]></expression>
			</element>
			<element kind="textField" x="132" y="22" width="441" height="12" fontName="DejaVu Sans" fontSize="8" forecolor="#5A6B85" hTextAlign="Left" vTextAlign="Top" blankWhenNull="true">
				<expression><![CDATA["Documento: " + $F{documento}]]></expression>
			</element>
			<element kind="rectangle" x="132" y="38" width="441" height="34" backcolor="#E8EEF7" mode="Opaque" radius="6">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="staticText" x="140" y="41" width="170" height="11" fontName="DejaVu Sans" fontSize="7" forecolor="#5A6B85" hTextAlign="Left" vTextAlign="Middle">
				<text><![CDATA[Sede]]></text>
			</element>
			<element kind="textField" x="140" y="53" width="170" height="16" fontName="DejaVu Sans" fontSize="8" forecolor="#16305C" hTextAlign="Left" vTextAlign="Top" bold="true" blankWhenNull="true" textAdjust="ScaleFont">
				<expression><![CDATA[$F{sede_nombre}]]></expression>
			</element>
			<element kind="staticText" x="314" y="41" width="86" height="11" fontName="DejaVu Sans" fontSize="7" forecolor="#5A6B85" hTextAlign="Left" vTextAlign="Middle">
				<text><![CDATA[Nivel]]></text>
			</element>
			<element kind="textField" x="314" y="53" width="86" height="16" fontName="DejaVu Sans" fontSize="8" forecolor="#16305C" hTextAlign="Left" vTextAlign="Top" bold="true" blankWhenNull="true" textAdjust="ScaleFont">
				<expression><![CDATA[$F{nivel_ensenanza}]]></expression>
			</element>
			<element kind="staticText" x="404" y="41" width="84" height="11" fontName="DejaVu Sans" fontSize="7" forecolor="#5A6B85" hTextAlign="Left" vTextAlign="Middle">
				<text><![CDATA[Grado]]></text>
			</element>
			<element kind="textField" x="404" y="53" width="84" height="16" fontName="DejaVu Sans" fontSize="8" forecolor="#16305C" hTextAlign="Left" vTextAlign="Top" bold="true" blankWhenNull="true" textAdjust="ScaleFont">
				<expression><![CDATA[$F{grado_nombre}]]></expression>
			</element>
			<element kind="staticText" x="492" y="41" width="76" height="11" fontName="DejaVu Sans" fontSize="7" forecolor="#5A6B85" hTextAlign="Left" vTextAlign="Middle">
				<text><![CDATA[Grupo]]></text>
			</element>
			<element kind="textField" x="492" y="53" width="76" height="16" fontName="DejaVu Sans" fontSize="8" forecolor="#16305C" hTextAlign="Left" vTextAlign="Top" bold="true" blankWhenNull="true" textAdjust="ScaleFont">
				<expression><![CDATA[$F{grupo_etiqueta}]]></expression>
			</element>
			<element kind="rectangle" x="132" y="78" width="250" height="20" backcolor="#E8EEF7" mode="Opaque" radius="6">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="staticText" x="140" y="78" width="45" height="20" fontName="DejaVu Sans" fontSize="8" forecolor="#16305C" hTextAlign="Left" vTextAlign="Middle" bold="true">
				<text><![CDATA[Periodo:]]></text>
			</element>
			<element kind="textField" x="185" y="78" width="192" height="20" fontName="DejaVu Sans" fontSize="8" forecolor="#16305C" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true">
				<expression><![CDATA[$F{anio} + " - " + $F{periodo_nombre}]]></expression>
			</element>
		</band>
		<band height="28" splitType="Stretch">
			<element kind="rectangle" x="40" y="0" width="533" height="22" backcolor="#16305C" mode="Opaque" radius="6" stretchType="ContainerHeight">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="textField" x="52" y="0" width="509" height="22" fontName="DejaVu Sans" fontSize="10" forecolor="#FFFFFF" hTextAlign="Left" vTextAlign="Middle" bold="true" textAdjust="StretchHeight">
				<expression><![CDATA[$F{asignatura_nombre} == null || $F{asignatura_nombre}.trim().isEmpty() ? "SEGUIMIENTO Y VALORACION" : $F{asignatura_nombre}.toUpperCase()]]></expression>
				<box topPadding="5" bottomPadding="5"/>
			</element>
		</band>
		<band height="34" splitType="Stretch">
			<element kind="textField" x="40" y="4" width="533" height="22" fontName="DejaVu Sans" fontSize="9" forecolor="#16305C" hTextAlign="Justified" vTextAlign="Top" textAdjust="StretchHeight">
				<expression><![CDATA[$F{observacion} == null || $F{observacion}.trim().isEmpty() ? "Sin observaciones registradas para este periodo." : $F{observacion}]]></expression>
				<box topPadding="8" leftPadding="10" bottomPadding="8" rightPadding="10">
					<pen lineWidth="0.75" lineColor="#9FB3D1"/>
				</box>
			</element>
		</band>
		<band height="348" splitType="Prevent">
			<printWhenExpression><![CDATA[(($F{evidencia1_archivo} != null || !"".equals($F{evidencia1_titulo} == null ? "" : $F{evidencia1_titulo}.trim()) ? 1 : 0) + ($F{evidencia2_archivo} != null || !"".equals($F{evidencia2_titulo} == null ? "" : $F{evidencia2_titulo}.trim()) ? 1 : 0) + ($F{evidencia3_archivo} != null || !"".equals($F{evidencia3_titulo} == null ? "" : $F{evidencia3_titulo}.trim()) ? 1 : 0) + ($F{evidencia4_archivo} != null || !"".equals($F{evidencia4_titulo} == null ? "" : $F{evidencia4_titulo}.trim()) ? 1 : 0) + ($F{evidencia5_archivo} != null || !"".equals($F{evidencia5_titulo} == null ? "" : $F{evidencia5_titulo}.trim()) ? 1 : 0) + ($F{evidencia6_archivo} != null || !"".equals($F{evidencia6_titulo} == null ? "" : $F{evidencia6_titulo}.trim()) ? 1 : 0)) == 1]]></printWhenExpression>
			<element kind="rectangle" x="40" y="0" width="533" height="22" backcolor="#16305C" mode="Opaque" radius="6">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="staticText" x="52" y="0" width="400" height="22" fontName="DejaVu Sans" fontSize="10" forecolor="#FFFFFF" hTextAlign="Left" vTextAlign="Middle" bold="true">
				<text><![CDATA[EVIDENCIAS DE APRENDIZAJE]]></text>
			</element>
			<element kind="rectangle" x="96" y="30" width="420" height="310" backcolor="#F2F6FC" mode="Opaque" radius="6">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="image" x="100" y="34" width="412" height="270" scaleImage="RetainShape" hImageAlign="Center" vImageAlign="Middle" onErrorType="Blank">
				<expression><![CDATA[$F{evidencia1_archivo}]]></expression>
			</element>
			<element kind="textField" x="102" y="304" width="408" height="22" fontName="DejaVu Sans" fontSize="8" forecolor="#16305C" hTextAlign="Left" vTextAlign="Middle" bold="true" blankWhenNull="true">
				<expression><![CDATA[$F{evidencia1_titulo}]]></expression>
			</element>
			<element kind="textField" x="102" y="327" width="408" height="10" fontName="DejaVu Sans" fontSize="6" forecolor="#5A6B85" hTextAlign="Right" vTextAlign="Top" blankWhenNull="true">
				<expression><![CDATA[$F{evidencia1_fecha}]]></expression>
			</element>
		</band>
		<band height="298" splitType="Prevent">
			<printWhenExpression><![CDATA[(($F{evidencia1_archivo} != null || !"".equals($F{evidencia1_titulo} == null ? "" : $F{evidencia1_titulo}.trim()) ? 1 : 0) + ($F{evidencia2_archivo} != null || !"".equals($F{evidencia2_titulo} == null ? "" : $F{evidencia2_titulo}.trim()) ? 1 : 0) + ($F{evidencia3_archivo} != null || !"".equals($F{evidencia3_titulo} == null ? "" : $F{evidencia3_titulo}.trim()) ? 1 : 0) + ($F{evidencia4_archivo} != null || !"".equals($F{evidencia4_titulo} == null ? "" : $F{evidencia4_titulo}.trim()) ? 1 : 0) + ($F{evidencia5_archivo} != null || !"".equals($F{evidencia5_titulo} == null ? "" : $F{evidencia5_titulo}.trim()) ? 1 : 0) + ($F{evidencia6_archivo} != null || !"".equals($F{evidencia6_titulo} == null ? "" : $F{evidencia6_titulo}.trim()) ? 1 : 0)) == 2]]></printWhenExpression>
			<element kind="rectangle" x="40" y="0" width="533" height="22" backcolor="#16305C" mode="Opaque" radius="6">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="staticText" x="52" y="0" width="400" height="22" fontName="DejaVu Sans" fontSize="10" forecolor="#FFFFFF" hTextAlign="Left" vTextAlign="Middle" bold="true">
				<text><![CDATA[EVIDENCIAS DE APRENDIZAJE]]></text>
			</element>
			<element kind="rectangle" x="40" y="30" width="261" height="260" backcolor="#F2F6FC" mode="Opaque" radius="6">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="image" x="44" y="34" width="253" height="220" scaleImage="RetainShape" hImageAlign="Center" vImageAlign="Middle" onErrorType="Blank">
				<expression><![CDATA[$F{evidencia1_archivo}]]></expression>
			</element>
			<element kind="textField" x="46" y="254" width="249" height="22" fontName="DejaVu Sans" fontSize="8" forecolor="#16305C" hTextAlign="Left" vTextAlign="Middle" bold="true" blankWhenNull="true">
				<expression><![CDATA[$F{evidencia1_titulo}]]></expression>
			</element>
			<element kind="textField" x="46" y="277" width="249" height="10" fontName="DejaVu Sans" fontSize="6" forecolor="#5A6B85" hTextAlign="Right" vTextAlign="Top" blankWhenNull="true">
				<expression><![CDATA[$F{evidencia1_fecha}]]></expression>
			</element>
			<element kind="rectangle" x="311" y="30" width="261" height="260" backcolor="#F2F6FC" mode="Opaque" radius="6">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="image" x="315" y="34" width="253" height="220" scaleImage="RetainShape" hImageAlign="Center" vImageAlign="Middle" onErrorType="Blank">
				<expression><![CDATA[$F{evidencia2_archivo}]]></expression>
			</element>
			<element kind="textField" x="317" y="254" width="249" height="22" fontName="DejaVu Sans" fontSize="8" forecolor="#16305C" hTextAlign="Left" vTextAlign="Middle" bold="true" blankWhenNull="true">
				<expression><![CDATA[$F{evidencia2_titulo}]]></expression>
			</element>
			<element kind="textField" x="317" y="277" width="249" height="10" fontName="DejaVu Sans" fontSize="6" forecolor="#5A6B85" hTextAlign="Right" vTextAlign="Top" blankWhenNull="true">
				<expression><![CDATA[$F{evidencia2_fecha}]]></expression>
			</element>
		</band>
		<band height="328" splitType="Prevent">
			<printWhenExpression><![CDATA[(($F{evidencia1_archivo} != null || !"".equals($F{evidencia1_titulo} == null ? "" : $F{evidencia1_titulo}.trim()) ? 1 : 0) + ($F{evidencia2_archivo} != null || !"".equals($F{evidencia2_titulo} == null ? "" : $F{evidencia2_titulo}.trim()) ? 1 : 0) + ($F{evidencia3_archivo} != null || !"".equals($F{evidencia3_titulo} == null ? "" : $F{evidencia3_titulo}.trim()) ? 1 : 0) + ($F{evidencia4_archivo} != null || !"".equals($F{evidencia4_titulo} == null ? "" : $F{evidencia4_titulo}.trim()) ? 1 : 0) + ($F{evidencia5_archivo} != null || !"".equals($F{evidencia5_titulo} == null ? "" : $F{evidencia5_titulo}.trim()) ? 1 : 0) + ($F{evidencia6_archivo} != null || !"".equals($F{evidencia6_titulo} == null ? "" : $F{evidencia6_titulo}.trim()) ? 1 : 0)) == 3]]></printWhenExpression>
			<element kind="rectangle" x="40" y="0" width="533" height="22" backcolor="#16305C" mode="Opaque" radius="6">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="staticText" x="52" y="0" width="400" height="22" fontName="DejaVu Sans" fontSize="10" forecolor="#FFFFFF" hTextAlign="Left" vTextAlign="Middle" bold="true">
				<text><![CDATA[EVIDENCIAS DE APRENDIZAJE]]></text>
			</element>
			<element kind="rectangle" x="40" y="30" width="261" height="290" backcolor="#F2F6FC" mode="Opaque" radius="6">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="image" x="44" y="34" width="253" height="250" scaleImage="RetainShape" hImageAlign="Center" vImageAlign="Middle" onErrorType="Blank">
				<expression><![CDATA[$F{evidencia1_archivo}]]></expression>
			</element>
			<element kind="textField" x="46" y="284" width="249" height="22" fontName="DejaVu Sans" fontSize="8" forecolor="#16305C" hTextAlign="Left" vTextAlign="Middle" bold="true" blankWhenNull="true">
				<expression><![CDATA[$F{evidencia1_titulo}]]></expression>
			</element>
			<element kind="textField" x="46" y="307" width="249" height="10" fontName="DejaVu Sans" fontSize="6" forecolor="#5A6B85" hTextAlign="Right" vTextAlign="Top" blankWhenNull="true">
				<expression><![CDATA[$F{evidencia1_fecha}]]></expression>
			</element>
			<element kind="rectangle" x="311" y="30" width="261" height="140" backcolor="#F2F6FC" mode="Opaque" radius="6">
				<pen lineWidth="0.0"/>
			</element>
			<element kind="image" x="315" y="34" width="253" height="100" scaleImage="RetainShape" hImageAlign="Center" vImageAlign="Middle" onErrorType="Blank">
				<expression><![CDATA[$F{evidencia2_archivo}]]></expression>
			</element>
			<element kind="textField" x="317" y="134" width="249" height="22" fontName="DejaVu Sans" fontSize="8" forecolor="#16305C" hTextAlign="Left" vTextAlign="Middle" bold="true" blankWhenNull="true">
				<expression><![CDATA[$F{evidencia2_titulo}]]></expression>
			</element>
			<element kind="textField" x="317" y="157" width="249" height="10" fontName="DejaVu Sans" fontSize="6" forecolor="#5A6B85" hTextAlign="Right" vTextAlign="Top" blankWhenNull="true">
				<expression><![CDATA[$F{evidencia2_fecha}]]></expression>
			</element>
