				<expression><![CDATA[$F{grupo_etiqueta} + ("".equals($F{jornada}) ? "" : " " + $F{jornada}.substring(0, 1).toUpperCase() + $F{jornada}.substring(1).toLowerCase())]]></expression>
			</element>
			<element kind="rectangle" x="132" y="78" width="441" height="20" backcolor="#E8EEF7" mode="Opaque" radius="6">
				<propertyExpression name="net.sf.jasperreports.style.backcolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "panel")]]></propertyExpression>
				<pen lineWidth="0.0"/>
			</element>
			<element kind="staticText" x="138" y="80" width="16" height="16" fontName="Material Icons" fontSize="14" forecolor="#16305C" hTextAlign="Center" vTextAlign="Middle">
				<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "acento")]]></propertyExpression>
				<text><![CDATA[]]></text>
			</element>
			<element kind="staticText" x="160" y="78" width="50" height="20" fontName="DejaVu Sans" fontSize="9" forecolor="#16305C" hTextAlign="Left" vTextAlign="Middle" bold="true">
				<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "acento")]]></propertyExpression>
				<text><![CDATA[Periodo:]]></text>
			</element>
			<element kind="textField" x="210" y="78" width="355" height="20" fontName="DejaVu Sans" fontSize="9" forecolor="#16305C" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true">
				<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "texto")]]></propertyExpression>
				<expression><![CDATA[$F{anio} + " - " + $F{periodo_nombre}]]></expression>
			</element>
		</band>
		<band height="24" splitType="Stretch">
			<element kind="line" x="50" y="11" width="523" height="1" forecolor="#16305C">
				<propertyExpression name="net.sf.jasperreports.style.forecolor"><![CDATA[com.co.eurekatic.reporting.render.TonoFondo.color($F{fondo_archivo}, "acento")]]></propertyExpression>
				<pen lineWidth="1.25"/>
			</element>
			<element kind="rectangle" x="40" y="0" width="330" height="22" backcolor="#16305C" mode="Opaque" radius="11" stretchType="ContainerHeight">
