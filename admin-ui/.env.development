# Dev: Vite dev server on :5173, proxy /api -> http://localhost:8080
# (the api-gateway). Same-origin from the browser's perspective.
VITE_API_BASE=/api

# Scopes the sidebar to a single App on the backend: menuApi.getMyMenu
# appends ?app=<name> to GET /sso-admin/myMenu so the backend filters
# routes to this app only (see MyMenuController/MyMenuService). Must
# match an app.name row exactly (case-sensitive) — SSO-ADMIN is the
# canonical name seeded by postgres/init/09-seed-sso-admin-app.sh.
VITE_APP_NAME=SSO-ADMIN
