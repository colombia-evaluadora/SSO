# syntax=docker/dockerfile:1.7
#
# Local-only Dockerfile: packages an already-built sso-admin.jar
# into a slim runtime image. Used when the maven build inside
# Docker runs out of memory (colima default is too low). The jar
# is built on the host (see /tmp/build-ssoadmin.sh) and bind-mounted
# or COPY'd into the runtime image.

FROM eclipse-temurin:25-jre-jammy
WORKDIR /app

RUN groupadd --system --gid 1000 app && \
    useradd  --system --uid 1000 --gid app --home /app app

COPY sso-admin/target/sso-admin.jar /app/app.jar

USER app
EXPOSE 8083

ENTRYPOINT ["java", \
    "-XX:+UseContainerSupport", \
    "-XX:MaxRAMPercentage=75", \
    "-Djava.security.egd=file:/dev/./urandom", \
    "-jar", "/app/app.jar"]
