        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "eval-col",
            "listas-valor",
            "categorias"
          ],
          "query": [
            {
              "key": "BUSCAR",
              "value": "estado"
            }
          ],
          "raw": "{{baseUrl}}/api/eval-col/listas-valor/categorias?BUSCAR=estado"
        },
        "description": {
          "content": "Listas activas, habilitadas o no, con `descripcion`, `categoriaPadre`, `esOrdinal`, `habilitada`, `totalValores`, `esSistema` y `predeterminado`. `BUSCAR` filtra por código (con `_` o espacios) o descripción.",
          "type": "text/markdown"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const res = pm.response.json().rows[0].resultado;",
              "pm.test('arreglo', () => pm.expect(res).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - Crear lista padre con valores",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
