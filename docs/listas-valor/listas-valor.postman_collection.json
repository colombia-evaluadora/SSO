        ],
        "url": {
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "eval-col",
            "listas-valor",
            "categorias"
          ],
          "raw": "{{baseUrl}}/api/eval-col/listas-valor/categorias"
        },
        "description": {
          "content": "Lista sin lista padre con dos valores en el orden enviado; el primero queda predeterminado. Guarda `padreId` y `padre2Id`.",
          "type": "text/markdown"
        },
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\n  \"CATEGORIA\": \"{{categoriaPadre}}\",\n  \"NOMBRE\": \"Departamento (prueba)\",\n  \"DESCRIPCION\": \"Departamentos de prueba de la colección Postman\",\n  \"VALORES\": \"[{\\\"nombre\\\":\\\"Antioquia\\\",\\\"valor\\\":\\\"ANTIOQUIA\\\",\\\"predeterminado\\\":true},{\\\"nombre\\\":\\\"Santander\\\",\\\"valor\\\":\\\"SANTANDER\\\"}]\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const res = pm.response.json().rows[0].resultado;",
              "pm.environment.set('padreId', res.valores[0].pkListaValor);",
              "pm.environment.set('padre2Id', res.valores[1].pkListaValor);",
              "pm.test('orden 1..n', () => pm.expect(res.valores.map(v => v.orden)).to.eql([1, 2]));",
              "pm.test('predeterminado', () => pm.expect(res.predeterminado).to.eql(res.valores[0].pkListaValor));",
              "pm.test('nombre visible', () => pm.expect(res.nombre).to.eql('Departamento (prueba)'));"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - Crear lista hija con lista padre",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
