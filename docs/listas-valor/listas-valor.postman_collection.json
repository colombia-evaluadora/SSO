        "url": {
          "raw": "{{baseUrl}}/api/eval-col/listas-valor/{{hijo2Id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "eval-col",
            "listas-valor",
            "{{hijo2Id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\n  \"NOMBRE\": \"Envigado (editado)\",\n  \"ACCION\": null,\n  \"PADRE\": {{padre2Id}}\n}"
        },
        "description": {
          "content": "Reemplaza nombre, acción y padre. `CATEGORIA` y `VALOR` no se editan. Un campo omitido queda en NULL.",
          "type": "text/markdown"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const res = pm.response.json().rows[0].resultado;",
              "pm.test('nombre y padre nuevos', () => { pm.expect(res.nombre).to.eql('Envigado (editado)'); pm.expect(res.padre.pkListaValor).to.eql(Number(pm.environment.get('padre2Id'))); });"
            ]
          }
        }
      ]
    },
