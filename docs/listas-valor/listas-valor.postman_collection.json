            "listas-valor",
            "categorias"
          ],
          "raw": "{{baseUrl}}/api/eval-col/listas-valor/categorias"
        },
        "description": {
          "content": "`PADRE` es el código de la lista padre: cada valor debe llevar un `padre` de esa lista. Sin `NOMBRE`, se deriva del código. Guarda `hijoId`.",
          "type": "text/markdown"
        },
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\n  \"CATEGORIA\": \"{{categoriaHija}}\",\n  \"PADRE\": \"{{categoriaPadre}}\",\n  \"VALORES\": \"[{\\\"nombre\\\":\\\"Medellín\\\",\\\"valor\\\":\\\"MEDELLIN\\\",\\\"padre\\\":{{padreId}}}]\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const res = pm.response.json().rows[0].resultado;",
              "pm.test('nombre derivado del código', () => pm.expect(res.nombre).to.eql('Prueba municipio'));",
              "pm.environment.set('hijoId', res.valores[0].pkListaValor);",
              "pm.test('lista padre', () => pm.expect(res.categoriaPadre).to.eql(pm.collectionVariables.get('categoriaPadre')));",
              "pm.test('valor padre', () => pm.expect(res.valores[0].padre.pkListaValor).to.eql(Number(pm.environment.get('padreId'))));"
            ]
          }
        }
      ]
    },
