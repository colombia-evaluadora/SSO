          ]
        },
        {
          "name": "2 - POST agregar UN soporte",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json().rows || pm.response.json();",
                  "const pk = Array.isArray(rows) ? rows[0].pk_tactividad_soporte : rows.pk_tactividad_soporte;",
                  "pm.test('devuelve pk_tactividad_soporte', () => pm.expect(pk).to.be.a('number'));",
                  "pm.collectionVariables.set('soporteId', pk);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"FK_TARCHIVO\": {{tarchivoId}},\n  \"FECHA\": \"2026-06-22\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/eval-col/planeador/actividades/estudiantes/{{actividadEstudianteId}}/soportes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eval-col",
                "planeador",
                "actividades",
                "estudiantes",
                "{{actividadEstudianteId}}",
                "soportes"
              ]
            },
            "description": "Adjunta UN archivo a la observacion sin tocar los demas (`fn_actividad_observacion_soporte_agregar`, V461). `BODY.FK_TARCHIVO` (BIGINT, obligatorio): el PK que devolvio el file-service al subir el binario (`POST /api/files/**`); debe existir y estar ACTIVE. `BODY.FECHA` (DATE, opcional, default hoy): fecha con asistencia valida del estudiante, misma regla que `PUT .../observar` (usar la columna `fecha` que devuelve la planilla / `fn_actividad_asistencia_fecha_resolver`). Idempotente: repetir el mismo archivo devuelve el mismo pk; uno retirado se reactiva. Gate EDITAR sobre PLANEADOR. Roles: CEVAL-DOCENTE, CEVAL-SUPER_ADMINISTRADOR."
          },
