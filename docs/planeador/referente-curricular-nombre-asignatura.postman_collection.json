                "referentes-curriculares",
                "personalizar-asignatura"
              ]
            },
            "description": "Valores con los que un referente puede nombrar su asignatura. La migracion siembra tres: **Asignatura**, **Dimension** y **Area**. `es_semilla` los marca (no se pueden eliminar) y `en_uso` dice cuantos referentes vigentes apuntan a cada uno, para que la UI sepa de antemano cual fallaria al borrar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json(); const filas = j.data || j;",
                  "const porValor = Object.fromEntries(filas.map(f => [f.valor, f]));",
                  "pm.test('estan los tres basicos', () => ['Asignatura', 'Dimension', 'Area'].forEach(v => pm.expect(porValor).to.have.property(v)));",
                  "pm.test('los tres van marcados como semilla', () => ['Asignatura', 'Dimension', 'Area'].forEach(v => pm.expect(porValor[v].es_semilla).to.eql(true)));",
                  "pm.collectionVariables.set('idAsignatura', porValor['Asignatura'].pk_lista_valor);",
                  "pm.collectionVariables.set('idDimension', porValor['Dimension'].pk_lista_valor);"
                ]
              }
            }
          ]
