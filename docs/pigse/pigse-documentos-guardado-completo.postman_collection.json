        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ANEXOS\": [\n    {\n      \"categoria\": \"PLAN_ESTUDIOS\",\n      \"archivoId\": \"{{archivoPlan}}\"\n    },\n    {\n      \"categoria\": \"SIEE\",\n      \"archivoId\": \"{{archivoSiee}}\"\n    },\n    {\n      \"categoria\": \"MANUAL_CONVIVENCIA\",\n      \"archivoId\": \"{{archivoManual}}\"\n    },\n    {\n      \"categoria\": \"PROYECTOS_TRANSVERSALES\",\n      \"archivoId\": \"{{archivoProyectos}}\"\n    }\n  ],\n  \"QUITAR\": []\n}"
        }
