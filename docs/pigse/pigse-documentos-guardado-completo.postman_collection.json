        ],
        "url": {
          "raw": "{{baseUrl}}/api/pigse/documentos/{{tipo}}/anexos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pigse",
            "documentos",
            "{{tipo}}",
            "anexos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ANEXOS\": [\n    {\n      \"categoria\": \"PLAN_ESTUDIOS\",\n      \"archivoId\": \"{{archivoPlan}}\"\n    },\n    {\n      \"categoria\": \"SIEE\",\n      \"archivoId\": \"{{archivoSiee}}\"\n    }\n  ],\n  \"QUITAR\": []\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
