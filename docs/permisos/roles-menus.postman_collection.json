    {
      "name": "1 — GET menús del rol",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const rows = pm.response.json().rows;",
              "pm.test('rows es array', () => pm.expect(rows).to.be.an('array'));",
              "if (rows.length) pm.test('fila { id, soloLectura }', () => { pm.expect(rows[0]).to.have.property('id'); pm.expect(rows[0].soloLectura).to.be.a('boolean'); });",
              "const orden = JSON.parse(pm.collectionVariables.get('ordenCatalogo') || '[]');",
              "if (orden.length && rows.length) pm.test('en el orden del catálogo', () => {",
              "  const pos = rows.map(r => orden.indexOf(r.id));",
              "  pm.expect(pos).to.eql([...pos].sort((a, b) => a - b));",
              "});",
              "pm.collectionVariables.set('menusRol', JSON.stringify(rows));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/eval-col/roles/{{roleId}}/menus",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "eval-col",
            "roles",
            "{{roleId}}",
            "menus"
          ]
        },
        "description": "Menús activos asignados al rol como `{ id, soloLectura }` (mismo elemento que el body del `PUT`), en el orden del catálogo de `GET /menus`. `[]` si el rol no existe o no tiene menús."
      }
