    {
      "name": "0 — Login (ver la respuesta)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const token = pm.response.json().token;",
              "pm.test('devuelve token', () => pm.expect(token).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('token', token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "1a — GET catálogo de menús",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const rows = pm.response.json().rows;",
              "pm.test('MenuNode', () => ['id','name','icon','path','menuOrder','type','idParent'].forEach(k => pm.expect(rows[0]).to.have.property(k)));",
              "pm.collectionVariables.set('ordenCatalogo', JSON.stringify(rows.map(r => r.id)));",
              "const padre = rows.find(r => r.id == pm.collectionVariables.get('menuPadre'));",
              "if (padre) pm.collectionVariables.set('menuPadreOrden', String(padre.menuOrder ?? 0));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/eval-col/menus",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "eval-col",
            "menus"
          ]
        },
        "description": "Catálogo completo (`MenuNode[]`) en orden de árbol: cada grupo por su `menuOrder`, el padre antes que sus hijos. Guarda el orden para comprobar `GET /roles/:roleId/menus` y el `menuOrder` actual de `menuPadre` para el paso 1b."
      }
    },
