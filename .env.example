# =============================================================================
# Environment file for `docker compose up`. Copy to `.env` and edit.
#
# All secrets here are dev-only defaults. PRODUCTION deployments
# MUST set real values via the deployment platform's secret store
# (e.g. AWS Secrets Manager, Vault, k8s Secret). Do NOT ship the
# real values in this file.
# =============================================================================

# ---- Compose profiles (optional services) -------------------------------------
# `diagnostics` gates hello-service (pure reference/diagnostic
# service — nothing depends_on it, safe to skip). Active by default
# so local dev keeps getting the full stack unchanged.
#
# `cdc-sync` gates cdc-capture, cdc-worker and cdc-clickhouse.
# When enabled, BOTH `local-only` and `cdc-sync` must be set so the
#   shared `postgres` (debezium/postgres with wal_level=logical,
#   required for CDC) comes up. Use:
#     COMPOSE_PROFILES=local-only,cdc-sync
# on the test server, the `postgres` service is opt-in and the CDC
# apps reference it from `postgres`, so omitting the profile is the
# default prod posture (no CDC on the public server).
#
# ON THE TEST SERVER: do NOT add `diagnostics` to COMPOSE_PROFILES —
# leave hello-service skipped and its ~192-256MB of RAM free.
COMPOSE_PROFILES=diagnostics

# ---- Image source (local build vs GHCR pull) ---------------------------------
# Every app service in docker-compose.yml names its image as
#   ${IMAGE_PREFIX}/<service>:${IMAGE_TAG}
# Defaults (unset) keep today's local-dev behavior: eurekatic/<svc>
# :1.0.0-SNAPSHOT built by `docker compose build`.
# On the TEST SERVER set these so `docker compose pull` fetches the
# images CI published (see .github/workflows/deploy-test.yml):
#   IMAGE_PREFIX=ghcr.io/colombia-evaluadora
#   IMAGE_TAG=test-latest
#IMAGE_PREFIX=ghcr.io/colombia-evaluadora
#IMAGE_TAG=test-latest

# Compose project name. On the test server this MUST be set explicitly:
# the provisioner derives DOCKER_NETWORK from it (<name>_default), and
# compose's implicit default is the directory name, which varies by
# checkout location. Locally the compose default of `modernize` in
# docker-compose.yml keeps working without this.
#COMPOSE_PROJECT_NAME=sso

# Public origin the browser reaches the gateway on. Feeds the
# activation / restore-password links sso-admin emails out. On the
# test server set it to the real hostname or IP, e.g.
#   PUBLIC_BASE_URL=http://sso-test.example.com:8080
#PUBLIC_BASE_URL=http://localhost:8080

# Bind address for every published port EXCEPT the api-gateway (8080).
# Default 0.0.0.0 keeps local-dev ergonomics (reach eureka/grafana/
# mailhog from the host). On the TEST SERVER set 127.0.0.1 — Docker's
# published ports bypass ufw/firewalld, so loopback binding is the only
# real barrier keeping Postgres/Eureka/Grafana off the public internet.
# Reach them via SSH tunnel: ssh -L 3000:localhost:3000 user@server
#BIND_IP=127.0.0.1

# ---- Local postgres (compose opt-in dev fallback) ----------------------------
# Used ONLY by the `postgres` service in docker-compose.yml. No app in the
# runtime stack talks to it — every Spring service and the flyway container
# point at Neon via DB_URL below. Start it explicitly when you need it:
#   docker compose up -d postgres
# and reach it on localhost:${POSTGRES_PORT:-5432}.
POSTGRES_USER=sso
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=sso
POSTGRES_PORT=5432

# ---- Postgres (Neon cloud) ---------------------------------------------------
# The schema lives here. Every Spring service and the flyway container talk
# to Neon via the **pooler** endpoint (`-pooler` suffix on the host). The
# pooler is a PgBouncer-style proxy that multiplexes connections to the
# underlying Postgres cluster — strongly recommended by Neon for any
# serverless / short-lived workload because each request no longer pays
# the full TLS-handshake + SCRAM-SHA-256-PLUS round-trip cost.
#
# DB_URL is the network address only (host:port). Each service builds the
# full JDBC URL from DB_URL + DB_NAME + DB_SSLMODE + DB_CHANNEL_BINDING
# + DB_USER + DB_PASSWORD, e.g.
#   jdbc:postgresql://${DB_URL}/${DB_NAME}?sslmode=${DB_SSLMODE}&channel_binding=${DB_CHANNEL_BINDING}
# Keeping the network address separate from credentials / TLS knobs makes
# this file readable as a connection descriptor and lets the same
# DB_URL feed HikariCP, Flyway, and any future tool that wants the
# bare host:port.
#
# Two non-default query params are required for the pooler:
#   sslmode=require          — TLS to the pooler is mandatory
#   channel_binding=require  — the pooler enforces SCRAM-SHA-256-PLUS
#                              (SCRAM with channel binding tied to the
#                              TLS server certificate). Without this
#                              param the auth handshake fails with
#                              "channel binding required".
#
# Production: set via secret manager (AWS Secrets Manager / Vault / k8s
# Secret) — do NOT ship real values in this file. Dev placeholders below.
DB_URL=ep-xxxx-pooler.c-xxxx.aws.neon.tech:5432
DB_NAME=neondb
DB_USER=USER
DB_PASSWORD=changeme-rotateme
DB_SSLMODE=require
DB_CHANNEL_BINDING=require

# ---- query-service (postgres dialect) ----------------------------------------
# Same Neon DB. Mirrors the DB_* split above so the query-service can
# construct its own JDBC URL. Kept as separate vars because query-service
# can run multiple per-dialect pools (postgres / oracle / sqlserver) and
# each may eventually point at a different backing store.
QUERY_DS_POSTGRES_HOST=ep-xxxx-pooler.c-xxxx.aws.neon.tech
QUERY_DS_POSTGRES_PORT=5432
QUERY_DS_POSTGRES_NAME=neondb
QUERY_DS_POSTGRES_USER=USER
QUERY_DS_POSTGRES_PASSWORD=changeme-rotateme
QUERY_DS_POSTGRES_SSLMODE=require
QUERY_DS_POSTGRES_CHANNEL_BINDING=require
QUERY_DS_POSTGRES_ENABLED=true

# ---- Eureka -----------------------------------------------------------------
EUREKA_PORT=8761

# ---- auth-center ------------------------------------------------------------
AUTH_CENTER_PORT=8081

# ---- api-gateway ------------------------------------------------------------
API_GATEWAY_PORT=8080

# ---- hello-service ----------------------------------------------------------
HELLO_SERVICE_PORT=8082

# ---- JWT (RS256) ------------------------------------------------------------
# Los tokens se firman con RSA: auth-center tiene la clave PRIVADA y es
# el único que puede emitir; api-gateway, sso-admin y query-service sólo
# reciben la PÚBLICA y verifican. Antes había un único JWT_SECRET (HS256)
# compartido por los cinco servicios, lo que significaba que cualquiera
# de ellos podía forjar un token de admin.
#
# Genera el par y estas dos líneas con:
#
#     ./scripts/gen-jwt-keys.sh --env
#
# Los PEM van en una sola línea con los saltos escapados como \n —
# docker-compose no admite valores multilínea en .env, y
# JwtTokenService normaliza el whitespace antes de decodificar.
#
# #############################################################################
# #  EL PAR DE ABAJO ES SOLO PARA DESARROLLO LOCAL. NO USAR EN PRODUCCIÓN.    #
# #                                                                          #
# #  Esta clave privada está en el repositorio: cualquiera que pueda leer     #
# #  el código puede firmar un token de admin válido. Sirve para que          #
# #  `docker compose up` arranque sin ceremonia, nada más.                    #
# #                                                                          #
# #  Antes de cualquier despliegue real, incluido el servidor de pruebas:     #
# #                                                                          #
# #      ./scripts/gen-jwt-keys.sh --env                                      #
# #                                                                          #
# #  y pega las dos líneas que imprime encima de estas. El .env real está     #
# #  en .gitignore; este fichero (.env.example) no.                           #
# #############################################################################
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC11bzxMKrYo+K5\no4jTKcQYSkImmYbnI8KOIOSvb+A/uqPjc7+6gTuMMz2KDlog26c4FnwmgPtnUzRy\nZ6n3Ri8flwbipWvMkGScv0O6XRuBOevXpoV2Ih0YFzEQ3lcXmopSQkwNcmxkC7Pn\nu80N0tfOpwWr3lYOOCaH/jXjsN/EsFx/HpXwFR71MsTBC688xrGrbbtSqVfVeSSK\n76pM0xQuPIUjjMYtOG9OZfuN+2kITuqgr/j6aa3lldy7RWVxZnOufSoAHp7PI6JO\nsN2LKIPXNzIT819O6C31JnZ2U8PrFZvcqKnvqxIUVbUZweLiSWSGS/IFD7Vjv6w7\nZbWo/RZJAgMBAAECggEAA2SdjeGdhS/fspzvgsM4K8eHnvlFQr8QfxRJjXrYtCUQ\nharFWd6rT1/YZuEC2QidlkbDInkh19PTZMwe6Dnoy13cgh0EmzCu6UbfZb+dhwaJ\n6lWq5AwEaiHqp44tPAfv9f4oivqxikIL+sfEGTKFQOUDI9R2W3W8RamJH2Uk880E\n3UDn230DlojMTJY/OiBD0NnXzmCINuzfAPuyslbbNN/Xkx6/lzQzPeo3mu7QMWiO\nGtaitSh22SUt3UFfT8Rm/t3RnrcF3DfvahrWmF855s8lPnyKw0UBbsXquQwgnsxj\nSIXfvDm8gdsDnsSaZOeokLZ1nmkkYO9pbBp1UCXSRQKBgQD8BWJ6H1fETspZaJQP\nlxK33baxY/122nHdYMiVovVLz1pY/DcCjP6e2458Dqax3IGVktGIQZLg4VrHeCJy\nmqA98fTcfJG4t2/bJwnsXy01j67S2n5W4u2hsusp2FJBLGT422txciO22EiwQ2DM\nag+tP/5yMbGFIgBV5XowbSydjQKBgQC4tK0Qy4z20lt5sROMPZPjzJC3BjQD2Ai0\nsfOms8OJT/VI9nCaK4NABJC9BzB5XuXW1GQOe27P47DZi6gbXlgUSokkmWDsLryy\n/3n/ajoDqUzOCj6SJtd+gZ89jXKIx2Aus+RAVkjExddvHu/j9zqTsnRL64+0oMKG\nSan7Ix6WrQKBgGH+igMoas0nQeEwG9pQCPQ7ns0tLyJm4D2PY49jtPPMZboSICW6\nw0rr3mR4ofKo5i5Nz3Gm5cDRf6XuHZ7oZwSPL4IIYfUsRq81Z9NkUsTv4K+WS+fn\nBzWHx48W0S0MYRqu3wFWu3JeeS0oldwGJaBdMMggcIFu7ih4OWHZIa8FAoGBALKO\nXzv8OtKkuq+iok4RfTVbnY6BXalVn9zmpq9B2saUWH/nVSWE6QXrI+zI1XCPb8tF\nWVCyvIYWC/HSU3nZs3YyM/AAojTQXbUAynRCwcCmWsxYFPL+v5XZQxKi+dUGQJIF\nb6NOhlxLEZ+nnaqYZrU/b7OxDiREwKhG8B8KbVilAoGANGrXR56jrHd8dBb1mviH\nor9EeomphoYHM3CqjXLtSzexNCzNLCJvw3TjkjUC470hr/qNSW9FnqoVTEVq2jN8\nkHmpPVzjFx7rPDIKhYSJCNdXrmNoNxHLfjGfzL1HhBUUWE9ZbuS5LcyvJesp9trp\nWMHT32yyOYDmfRgYnXybaT0=\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAtdW88TCq2KPiuaOI0ynE\nGEpCJpmG5yPCjiDkr2/gP7qj43O/uoE7jDM9ig5aINunOBZ8JoD7Z1M0cmep90Yv\nH5cG4qVrzJBknL9Dul0bgTnr16aFdiIdGBcxEN5XF5qKUkJMDXJsZAuz57vNDdLX\nzqcFq95WDjgmh/4147DfxLBcfx6V8BUe9TLEwQuvPMaxq227UqlX1Xkkiu+qTNMU\nLjyFI4zGLThvTmX7jftpCE7qoK/4+mmt5ZXcu0VlcWZzrn0qAB6ezyOiTrDdiyiD\n1zcyE/NfTugt9SZ2dlPD6xWb3Kip76sSFFW1GcHi4klkhkvyBQ+1Y7+sO2W1qP0W\nSQIDAQAB\n-----END PUBLIC KEY-----\n"

# ---- Redis (auth-center refresh-token store) --------------------------------
# Empty default for dev. Production: set in secret manager. With an
# empty password the redis service runs without --requirepass; do
# not expose Redis to the network without setting this in real envs.
REDIS_PASSWORD=

# ---- Session-cache (effective roles in Redis) -------------------------------
# Shared secret gating POST /internal/cache/user-roles/{email} on
# auth-center. sso-admin includes it as the X-Session-Cache-Secret
# header after every role / group binding mutation. MUST be set
# identically on auth-center and sso-admin (one env var feeds both
# via Spring relaxed binding). Empty default rejects every request,
# which is the documented fail-closed posture on the controller side;
# admin mutations still succeed, the cache self-heals within one TTL.
# Production: set in secret manager.
SSO_SESSION_USER_ROLES_INVALIDATION_SECRET=

# Base URL sso-admin uses to call auth-center's cache-invalidation
# endpoint. Default is compose-DNS (http://auth-center:8081). For
# host-mode dev outside compose, override to
# SSO_AUTH_CENTER_BASE_URL=http://localhost:8081. Ignored if the
# shared secret above is empty (the client becomes a no-op).
SSO_AUTH_CENTER_BASE_URL=http://auth-center:8081

# ---- V30 internal surface shared secret -------------------------------------
# Shared secret gating the /internal/** surface on sso-admin:
#   /internal/gateway/routes   (api-gateway CatalogRoutesRefresher)
#   /internal/pathTemplates    (query-service QueryPathRegistry)
# The filter is registered as InternalTokenFilter; it expects the
# X-Internal-Token header. Empty default rejects every request, so
# the gateway routes table stays empty and the path-registry stays
# empty until the operator sets the value. MUST be set identically
# on sso-admin (SSO_INTERNAL_TOKEN) AND every consumer:
#   api-gateway  → GATEWAY_INTERNAL_TOKEN (gateway catalog-refresh-ms etc.)
#   query-service → QUERY_CATALOG_INTERNAL_TOKEN
# In compose the value flows through docker's env block; in
# k8s deploy it via a single Secret projected into both
# Deployments. Production: store in your secret manager.
SSO_INTERNAL_TOKEN=change-me-internal-shared-secret-32-bytes-min
GATEWAY_INTERNAL_TOKEN=change-me-internal-shared-secret-32-bytes-min
QUERY_CATALOG_INTERNAL_TOKEN=change-me-internal-shared-secret-32-bytes-min

# ---- V33 — query-service resilience defaults ----------------------------
# Bulkhead caps CONCURRENT JDBC calls per dialect. When the
# cap+queue is full the request returns 503 BULKHEAD_FULL
# with Retry-After: 1. Tune down for hot dialects, up for
# cold ones. CI overrides these to small values to
# exercise the cap deterministically.
QUERY_BULKHEAD_MAX_CONCURRENT=20
QUERY_BULKHEAD_MAX_QUEUE=50
QUERY_BULKHEAD_WAIT_DURATION=200ms

# Rate limiter caps RPS per JWT principal (or per the
# shared "anonymous" bucket for /public/service traffic).
# Overflow returns 429 RATE_LIMITED with Retry-After: 1.
QUERY_RATE_LIMIT_RPS=100
QUERY_RATE_LIMIT_WINDOW=1s

# sso-admin calls this URL when a catalog mutation lands so
# query-service can refresh its path-registry immediately
# instead of waiting for the next 60s tick. In compose the
# docker-DNS name resolves; in host-mode dev override with
# http://localhost:8084.
QUERY_SERVICE_BASE_URL=http://query-service:8080

# ---- Bootstrap admin user (auth-center seeds on first start) ----------------
SSO_BOOTSTRAP_ENABLED=true
# Post-V12: email is the seed admin's login identifier. The
# legacy SSO_ADMIN_USERNAME is honored as a fallback by
# application.yml; setting SSO_ADMIN_EMAIL here wins.
SSO_ADMIN_EMAIL=admin@example.com
# SSO_ADMIN_USERNAME=admin   # legacy alias — remove once old .env files are gone
SSO_ADMIN_PASSWORD=ChangeMe-Now-Please-123!

# ---- sso-admin (User/Role/Group CRUD + activation emails) -------------------
SSO_ADMIN_PORT=8083

# ---- MailHog (dev-only SMTP catcher) ----------------------------------------
# Web UI: http://localhost:8025 — see every email sso-admin sends.
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# ---- Email branding (used in activation and restore-password templates) ----
SMTP_FROM=no-reply@example.com
SSO_EMAIL_COMPANY=Example Inc.
SSO_EMAIL_APP_NAME=SSO Modernizado
SSO_EMAIL_LOGO_URL=https://www.example.com/img/logo.png

# ---- Observability (Grafana LGTM stack) -------------------------------------
# Grafana UI: http://localhost:3000 (anonymous admin in dev).
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
# OTLP collector endpoint the Spring services push to. Inside compose
# this is the Alloy service; override for an external collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# Trace sampling rate (1.0 = 100%, dev). Lower in prod, e.g. 0.1.
OTEL_TRACING_SAMPLE_RATE=1.0
DEPLOY_ENV=dev

# ---- CORS allowlist (api-gateway + auth-center) ----------------------------
# Comma-separated list of origins allowed to call the API with
# credentials. The admin-ui SPA is served from the same origin in
# production (api-gateway:8080), so http://localhost:8080 is enough.
# Add your real public hostname in production.
# In dev, Vite runs on http://localhost:5173 and proxies /api to
# the gateway, so the SPA still sees a single origin.
SSO_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# ---- admin-ui SPA sidebar scoping (api-gateway build arg) ------------------
# Baked into the admin-ui Vite bundle at compose-build time
# (api-gateway/Dockerfile stage 1 picks it up as VITE_APP_NAME).
# When set, the SPA appends ?app=<value> on GET /sso-admin/myMenu
# and the sidebar only shows routes of that App on the backend.
# Value must match an `app.name` row exactly (case-sensitive;
# app.name is UNIQUE NOT NULL per App.java). The canonical value
# `SSO-ADMIN` is seeded by postgres/init/09-seed-sso-admin-app.sh.
# Leave blank to send no ?app= at all (the un-scoped union —
# every app the caller's roles grant).
VITE_APP_NAME=SSO-ADMIN

# ---- RabbitMQ (notification-service broker) -------------------------------
# Default dev creds; production MUST override in a secret store.
# Admin UI: http://localhost:15672 (loopback only).
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_MGMT_PORT=15672

# ---- notification-service ports -------------------------------------------
# Internal-only — NOT mapped to the host. The gateway exposes
# /notification-service/actuator/** via dynamic route locator.
# NOTIFICATION_SERVICE_PORT=8085

# ---- notification-service providers (optional — unset = provider disabled) -
# Each provider self-disables with a WARN at startup if its
# required env vars are absent. Leave blank in dev to keep all
# real providers disabled and route through the fakes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VONAGE_API_KEY=
VONAGE_API_SECRET=
SMTP_GMAIL_USER=
SMTP_GMAIL_PASS=
SMTP_BREVO_USER=
SMTP_BREVO_PASS=
RESEND_API_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Path inside the container to the FCM service-account JSON key.
# In dev leave empty — fcm provider self-disables. In prod, mount
# the file via a secret and set this to /run/secrets/fcm.json
GOOGLE_APPLICATION_CREDENTIALS=

# =============================================================================
# CDC-SYNC — PostgreSQL → ClickHouse (audit) + Oracle (mirror legacy)
# =============================================================================
#
# CDC-sync reuses the existing `postgres` (debezium, wal_level=logical),
# `rabbitmq` (with cdc user/exchange declared in docker/rabbitmq/definitions.json),
# and `flyway` (applies V22..V26 on top of V1..V19) services. Only cdc-capture,
# cdc-worker, and cdc-clickhouse are net-new.
#
# To enable:
#   COMPOSE_PROFILES=local-only,cdc-sync docker compose up -d
#
# `local-only` brings up the `postgres` container (with WAL logical);
# `cdc-sync` brings up cdc-capture, cdc-worker, cdc-clickhouse. The
# `rabbitmq` and `flyway` services are NOT profile-gated — they come up
# unconditionally.
#
# -----------------------------------------------------------------------------
# Flyway target override
# -----------------------------------------------------------------------------
# The default `flyway` service targets Neon (DB_URL/DB_NAME). When CDC-sync
# is enabled, Flyway must also apply V22..V26 (academic schema + publication
# + replica identity + context emitter) to the local `postgres`, which has
# WAL logical. Override FLYWAY_URL/USER/PASSWORD to point at the local DB.
#
# Production (Neon): leave these UNSET — Flyway applies V1..V19 to Neon.
# V22..V26 are academic schema scripts that target a CDC-enabled Postgres
# and would fail on Neon (no WAL logical, no CREATE PUBLICATION).
#
# Local CDC dev: set the three values below (matches the LOCAL_POSTGRES_*
# defaults above) so Flyway runs V1..V26 against the local `postgres`.
# LOCAL_POSTGRES_URL=jdbc:postgresql://postgres:5432/${POSTGRES_DB:-sso}?sslmode=disable
# LOCAL_POSTGRES_USER=${POSTGRES_USER}
# LOCAL_POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
# FLYWAY_URL=${LOCAL_POSTGRES_URL}
# FLYWAY_USER=${LOCAL_POSTGRES_USER}
# FLYWAY_PASSWORD=${LOCAL_POSTGRES_PASSWORD}
#
# When overrides are UNSET, the FLYWAY_URL/USER/PASSWORD in the
# postgres / Neon block above win. V22..V26 are top-level migrations
# in `./postgres/migrations/` (same as V1..V19), so the default
# `filesystem:/flyway/sql` location already includes them. The CDC
# gating is purely via FLYWAY_URL: Neon cannot satisfy
# `CREATE PUBLICATION` / `REPLICA IDENTITY FULL` (V24, V25), so without
# the FLYWAY_URL override pointing at the local `postgres` (with WAL
# logical), the V22..V26 step will fail.
#
# In short: to enable CDC schema bootstrap, uncomment the three
# LOCAL_POSTGRES_* + FLYWAY_* lines above. That's the entire bootstrap.

# -----------------------------------------------------------------------------
# CDC AMQP (rabbitmq user `cdc` declared in docker/rabbitmq/definitions.json)
# -----------------------------------------------------------------------------
# The SSO broker is shared (see `rabbitmq` block above). The `cdc` user
# + `cdc.events` exchange + bindings are added on top via the broker's
# definitions.json (loaded by rabbitmq.conf on boot). The SSO apps keep
# using ${RABBITMQ_USER}; only the CDC apps use the `cdc` account.
CDC_AMQP_USER=cdc
CDC_AMQP_PASSWORD=changeme
CDC_AMQP_PORT=5672

# -----------------------------------------------------------------------------
# CDC Postgres (the local `postgres` service, profile `local-only`)
# -----------------------------------------------------------------------------
# Source of truth for Debezium. CDC_PG_URL defaults to the local
# `postgres` in docker-compose.yml, so the SSO POSTGRES_* vars above
# already feed the CDC connection. Override only when pointing the
# CDC at a different DB (e.g. a dedicated academico DB instead of
# the SSO one — would require a CREATE DATABASE in V22).
# CDC_PG_URL=jdbc:postgresql://postgres:5432/${POSTGRES_DB:-sso}
# CDC_PG_USER=${POSTGRES_USER}
# CDC_PG_PASSWORD=${POSTGRES_PASSWORD}

# -----------------------------------------------------------------------------
# CDC ClickHouse (audit sink)
# -----------------------------------------------------------------------------
CDC_CLICKHOUSE_USER=default
CDC_CLICKHOUSE_PASSWORD=changeme
CDC_CLICKHOUSE_DB=auditoria
CDC_CLICKHOUSE_HTTP_PORT=58123
CDC_CLICKHOUSE_NATIVE_PORT=59000
# Enables ClickHouse's per-user SQL-driven access management (the
# "access_management" option in /etc/clickhouse-server/users.xml).
# Needed for the JDBC driver to issue GRANT/REVOKE; defaults to 1 in
# the upstream image. Set to 0 only if you run with an external auth
# provider that owns user management.
CDC_CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1

# -----------------------------------------------------------------------------
# CDC capture (Debezium embedded engine)
# -----------------------------------------------------------------------------
CDC_CAPTURE_PORT=58081
# Where the cdc-capture container persists offsets.dat (so Debezium
# resumes from the last LSN on restart). Backed by the named volume
# `cdc-sync-cdc-capture-offsets` — DO NOT mount a host bind here, the
# directory inside the container is owned by the JVM user.
CDC_OFFSETS_DIR=/var/cdc-capture/offsets

# -----------------------------------------------------------------------------
# CDC worker (Spring consumer)
# -----------------------------------------------------------------------------
CDC_WORKER_PORT=58082
# Destination toggles: decouple ClickHouse audit from Oracle reverse-sync.
# Set CDC_DEST_ORACLE=false to bypass the Oracle stage when its schema
# is broken; events still flow into ClickHouse and the queue drains
# without wasting retry budget.
CDC_DEST_CLICKHOUSE=true
CDC_DEST_ORACLE=true
# Consumer concurrency. Both default to 1 (single-thread behavior).
# Bump CDC_WORKER_CONCURRENCY_MAX when the queue is backlogged —
# Spring keeps min consumers idle-ready and scales up to max under load.
CDC_WORKER_CONCURRENCY_MIN=1
CDC_WORKER_CONCURRENCY_MAX=4
# JDBC URL passed to the ClickHouse HTTP driver. Defaults to the
# `cdc-clickhouse` service in docker-compose.yml. The username and
# password here are embedded in the URL because the ClickHouse JDBC
# driver doesn't read them from separate env vars.
# CDC_CLICKHOUSE_URL=http://default:changeme@cdc-clickhouse:8123

# -----------------------------------------------------------------------------
# CDC Oracle (reverse-sync sink — cdc-oracle service NOT included)
# -----------------------------------------------------------------------------
# The cdc-oracle container is NOT in this compose (its Dockerfile lives in
# a sibling repo, oracle-db/). When the operator wires it in, the CDC worker's
# Oracle destination block reads these three vars. Leaving them unset with
# CDC_DEST_ORACLE=true causes the worker to log + retry indefinitely.
# CDC_ORACLE_URL=jdbc:oracle:thin:@oracle:1521/FREEPDB1
# CDC_ORACLE_USER=ACADEMICO
# CDC_ORACLE_PASSWORD=changeme
