# =============================================================================
# Environment file for `docker compose up`. Copy to `.env` and edit.
#
# All secrets here are dev-only defaults. PRODUCTION deployments
# MUST set real values via the deployment platform's secret store
# (e.g. AWS Secrets Manager, Vault, k8s Secret). Do NOT ship the
# real values in this file.
# =============================================================================

# ---- Local postgres (compose opt-in dev fallback) ----------------------------
# Used ONLY by the `postgres` service in docker-compose.yml. No app in the
# runtime stack talks to it — every Spring service and the flyway container
# point at Neon via DB_URL below. Start it explicitly when you need it:
#   docker compose up -d postgres
# and reach it on localhost:${POSTGRES_PORT:-5432}.
POSTGRES_USER=sso
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=sso
POSTGRES_PORT=5432

# ---- Postgres (Neon cloud) ---------------------------------------------------
# The schema lives here. Every Spring service and the flyway container talk
# to Neon via the **pooler** endpoint (`-pooler` suffix on the host). The
# pooler is a PgBouncer-style proxy that multiplexes connections to the
# underlying Postgres cluster — strongly recommended by Neon for any
# serverless / short-lived workload because each request no longer pays
# the full TLS-handshake + SCRAM-SHA-256-PLUS round-trip cost.
#
# DB_URL is the network address only (host:port). Each service builds the
# full JDBC URL from DB_URL + DB_NAME + DB_SSLMODE + DB_CHANNEL_BINDING
# + DB_USER + DB_PASSWORD, e.g.
#   jdbc:postgresql://${DB_URL}/${DB_NAME}?sslmode=${DB_SSLMODE}&channel_binding=${DB_CHANNEL_BINDING}
# Keeping the network address separate from credentials / TLS knobs makes
# this file readable as a connection descriptor and lets the same
# DB_URL feed HikariCP, Flyway, and any future tool that wants the
# bare host:port.
#
# Two non-default query params are required for the pooler:
#   sslmode=require          — TLS to the pooler is mandatory
#   channel_binding=require  — the pooler enforces SCRAM-SHA-256-PLUS
#                              (SCRAM with channel binding tied to the
#                              TLS server certificate). Without this
#                              param the auth handshake fails with
#                              "channel binding required".
#
# Production: set via secret manager (AWS Secrets Manager / Vault / k8s
# Secret) — do NOT ship real values in this file. Dev placeholders below.
DB_URL=ep-xxxx-pooler.c-xxxx.aws.neon.tech:5432
DB_NAME=neondb
DB_USER=USER
DB_PASSWORD=changeme-rotateme
DB_SSLMODE=require
DB_CHANNEL_BINDING=require

# ---- query-service (postgres dialect) ----------------------------------------
# Same Neon DB. Mirrors the DB_* split above so the query-service can
# construct its own JDBC URL. Kept as separate vars because query-service
# can run multiple per-dialect pools (postgres / oracle / sqlserver) and
# each may eventually point at a different backing store.
QUERY_DS_POSTGRES_HOST=ep-xxxx-pooler.c-xxxx.aws.neon.tech
QUERY_DS_POSTGRES_PORT=5432
QUERY_DS_POSTGRES_NAME=neondb
QUERY_DS_POSTGRES_USER=USER
QUERY_DS_POSTGRES_PASSWORD=changeme-rotateme
QUERY_DS_POSTGRES_SSLMODE=require
QUERY_DS_POSTGRES_CHANNEL_BINDING=require
QUERY_DS_POSTGRES_ENABLED=true

# ---- Eureka -----------------------------------------------------------------
EUREKA_PORT=8761

# ---- auth-center ------------------------------------------------------------
AUTH_CENTER_PORT=8081

# ---- api-gateway ------------------------------------------------------------
API_GATEWAY_PORT=8080

# ---- hello-service ----------------------------------------------------------
HELLO_SERVICE_PORT=8082

# ---- JWT (MUST match across auth-center and api-gateway) --------------------
# 32+ bytes. Production: use a CSPRNG and store in a secret manager.
JWT_SECRET=change-me-change-me-change-me-change-me-change-me-1234567890

# ---- Redis (auth-center refresh-token store) --------------------------------
# Empty default for dev. Production: set in secret manager. With an
# empty password the redis service runs without --requirepass; do
# not expose Redis to the network without setting this in real envs.
REDIS_PASSWORD=

# ---- Session-cache (effective roles in Redis) -------------------------------
# Shared secret gating POST /internal/cache/user-roles/{email} on
# auth-center. sso-admin includes it as the X-Session-Cache-Secret
# header after every role / group binding mutation. MUST be set
# identically on auth-center and sso-admin (one env var feeds both
# via Spring relaxed binding). Empty default rejects every request,
# which is the documented fail-closed posture on the controller side;
# admin mutations still succeed, the cache self-heals within one TTL.
# Production: set in secret manager.
SSO_SESSION_USER_ROLES_INVALIDATION_SECRET=

# Base URL sso-admin uses to call auth-center's cache-invalidation
# endpoint. Default is compose-DNS (http://auth-center:8081). For
# host-mode dev outside compose, override to
# SSO_AUTH_CENTER_BASE_URL=http://localhost:8081. Ignored if the
# shared secret above is empty (the client becomes a no-op).
SSO_AUTH_CENTER_BASE_URL=http://auth-center:8081

# ---- Bootstrap admin user (auth-center seeds on first start) ----------------
SSO_BOOTSTRAP_ENABLED=true
# Post-V12: email is the seed admin's login identifier. The
# legacy SSO_ADMIN_USERNAME is honored as a fallback by
# application.yml; setting SSO_ADMIN_EMAIL here wins.
SSO_ADMIN_EMAIL=admin@example.com
# SSO_ADMIN_USERNAME=admin   # legacy alias — remove once old .env files are gone
SSO_ADMIN_PASSWORD=ChangeMe-Now-Please-123!

# ---- sso-admin (User/Role/Group CRUD + activation emails) -------------------
SSO_ADMIN_PORT=8083

# ---- MailHog (dev-only SMTP catcher) ----------------------------------------
# Web UI: http://localhost:8025 — see every email sso-admin sends.
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# ---- Email branding (used in activation and restore-password templates) ----
SMTP_FROM=no-reply@example.com
SSO_EMAIL_COMPANY=Example Inc.
SSO_EMAIL_APP_NAME=SSO Modernizado
SSO_EMAIL_LOGO_URL=https://www.example.com/img/logo.png

# ---- Observability (Grafana LGTM stack) -------------------------------------
# Grafana UI: http://localhost:3000 (anonymous admin in dev).
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
# OTLP collector endpoint the Spring services push to. Inside compose
# this is the Alloy service; override for an external collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# Trace sampling rate (1.0 = 100%, dev). Lower in prod, e.g. 0.1.
OTEL_TRACING_SAMPLE_RATE=1.0
DEPLOY_ENV=dev

# ---- CORS allowlist (api-gateway + auth-center) ----------------------------
# Comma-separated list of origins allowed to call the API with
# credentials. The admin-ui SPA is served from the same origin in
# production (api-gateway:8080), so http://localhost:8080 is enough.
# Add your real public hostname in production.
# In dev, Vite runs on http://localhost:5173 and proxies /api to
# the gateway, so the SPA still sees a single origin.
SSO_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# ---- admin-ui SPA sidebar scoping (api-gateway build arg) ------------------
# Baked into the admin-ui Vite bundle at compose-build time
# (api-gateway/Dockerfile stage 1 picks it up as VITE_APP_NAME).
# When set, the SPA appends ?app=<value> on GET /sso-admin/myMenu
# and the sidebar only shows routes of that App on the backend.
# Value must match an `app.name` row exactly (case-sensitive;
# app.name is UNIQUE NOT NULL per App.java). The canonical value
# `SSO-ADMIN` is seeded by postgres/init/09-seed-sso-admin-app.sh.
# Leave blank to send no ?app= at all (the un-scoped union —
# every app the caller's roles grant).
VITE_APP_NAME=SSO-ADMIN

# ---- RabbitMQ (notification-service broker) -------------------------------
# Default dev creds; production MUST override in a secret store.
# Admin UI: http://localhost:15672 (loopback only).
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_MGMT_PORT=15672

# ---- notification-service ports -------------------------------------------
# Internal-only — NOT mapped to the host. The gateway exposes
# /notification-service/actuator/** via dynamic route locator.
# NOTIFICATION_SERVICE_PORT=8085

# ---- notification-service providers (optional — unset = provider disabled) -
# Each provider self-disables with a WARN at startup if its
# required env vars are absent. Leave blank in dev to keep all
# real providers disabled and route through the fakes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VONAGE_API_KEY=
VONAGE_API_SECRET=
SMTP_GMAIL_USER=
SMTP_GMAIL_PASS=
SMTP_BREVO_USER=
SMTP_BREVO_PASS=
RESEND_API_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Path inside the container to the FCM service-account JSON key.
# In dev leave empty — fcm provider self-disables. In prod, mount
# the file via a secret and set this to /run/secrets/fcm.json
GOOGLE_APPLICATION_CREDENTIALS=
