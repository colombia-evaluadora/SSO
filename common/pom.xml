<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.co.eurekatic</groupId>
        <artifactId>sso-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>common</artifactId>
    <name>common</name>
    <description>Shared entities, repositories, DTOs, and security primitives for the modernized SSO</description>

    <dependencies>
        <!--
            common is a LIBRARY (not a Spring Boot application). It must not be
            repackaged with spring-boot-maven-plugin. Downstream modules
            (auth-center, api-gateway) pull its classes onto their own classpath
            and let their own @SpringBootApplication do the auto-config wiring.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <!--
            Argon2PasswordEncoder (PasswordEncoderFactory) delega en la
            implementación de Argon2id de BouncyCastle: spring-security-crypto
            declara la clase pero NO arrastra el proveedor, así que sin esto
            el primer login falla en runtime con NoClassDefFoundError, no al
            compilar. Va en common porque los tres servicios que hashean o
            verifican contraseñas heredan de aquí. La versión NO la gestiona
            el BOM de Spring Boot: se fija en las <properties> del padre.
        -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>provided</scope>
        </dependency>
        <!--
            AuditContextExtractor (com.co.eurekatic.common.audit) needs
            HttpServletRequest to read the audit-context headers/IP the same
            way query-service's QueryService.injectRequestParams already
            does. `provided` because common itself has no servlet container —
            every consumer that actually calls this class (auth-center,
            file-service, sso-admin) already carries spring-boot-starter-web
            transitively, which supplies the real jar at runtime. Modules
            without a web starter (e.g. notification-service, which doesn't
            use this class) are unaffected.
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- RequestContextHolder/ServletRequestAttributes live here, not in jakarta.servlet-api. Same `provided` rationale as above. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- ObjectMapper for AuditContextExtractor's request-body serialization. Same `provided` rationale: every consumer already carries jackson-databind via spring-boot-starter-web/-json. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            JJWT 0.12.x: split into api / impl / jackson. The impl and
            jackson modules are runtime-only; the api is needed at compile.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            OpenTelemetry Logback appender — the bridge that ships
            every log event to the OTLP collector (Grafana Alloy in
            this stack). Spring Boot 4's spring-boot-starter-opentelemetry
            does NOT include this dependency transitively (Spring Boot
            issue #50251 is the open tracking ticket). Without it,
            the OTLP logs exporter configured via
            management.opentelemetry.logging.export.otlp.endpoint has
            no appender to feed and Loki stays empty.
            Version pinned in the parent <properties> (see comment there).
        -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-appender-1.0</artifactId>
            <version>${opentelemetry-instrumentation.version}</version>
        </dependency>

        <!--
            swagger-models is needed here because common defines
            reusable OpenAPI building blocks consumed by the
            api-gateway aggregator:
              - OpenApiCatalogEntry (DTO returned by sso-admin's
                /internal/openapi/catalog, consumed by
                OpenApiAggregatorService to assemble the merged
                doc for source=catalog services)
              - OpenApiFactory (static helpers to build OpenAPI
                beans with the shared bearer-jwt security scheme)
            Note: do NOT depend on `org.springdoc:springdoc-openapi`
            here — that artifact is packaging=pom (a meta-artifact
            only; no .jar), so Maven fails dependency resolution
            with "Could not find artifact …:jar:VERSION in central".
            Each downstream module that needs the runtime pulls
            springdoc-openapi-starter-webmvc-ui or -webflux-ui
            (see api-gateway/pom.xml). common is a library and
            only needs the model classes from swagger-models.
        -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-models</artifactId>
            <version>2.2.31</version>
        </dependency>

        <!-- Test scope: H2 to exercise JPA mappings without a real Postgres -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Spring Boot 4 split the per-stack test auto-configure code
            out of spring-boot-test-autoconfigure into dedicated jars:
              - DataJpaTest       -> spring-boot-data-jpa-test
              - TestEntityManager -> spring-boot-jpa-test
            They are NOT pulled in by spring-boot-starter-test under
            4.0.x and must be declared explicitly with a version. The
            starter pulls the rest (junit-jupiter, assertj, mockito,
            spring-boot-test, spring-boot-test-autoconfigure) already.

            NOTE: declaring these deps WITHOUT <version> in a
            common/pom.xml that is installed into the local repo
            makes the POM "invalid" and Maven silently drops the
            transitive dependency resolution for downstream modules
            that depend on `common`. Pinning the version here fixes
            both the test compile and the downstream propagation.
            Version MUST be a literal — Maven does not expand
            ${spring-boot.version} (that's a plugin property, not
            a project property) inside <version> elements.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-data-jpa-test</artifactId>
            <version>4.0.7</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jpa-test</artifactId>
            <version>4.0.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
